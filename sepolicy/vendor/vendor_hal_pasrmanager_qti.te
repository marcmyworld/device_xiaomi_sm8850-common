# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_pasrmanager_qti sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_pasrmanager_qti vendor_hal_pasrmanager_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_pasrmanager_qti vendor_sysfs_system_memory:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_pasrmanager_qti vendor_sysfs_system_memory:file { ioctl read write getattr lock append map open watch watch_reads };
