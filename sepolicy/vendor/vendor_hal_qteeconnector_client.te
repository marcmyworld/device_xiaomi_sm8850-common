# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qteeconnector_client vendor_hal_qteeconnector_hwservice:hwservice_manager { find };
allow vendor_hal_qteeconnector_client vendor_hal_qteeconnector_server:binder { call transfer };
allow vendor_hal_qteeconnector_client vendor_hal_qteeconnector_server:binder { transfer };
allow vendor_hal_qteeconnector_client vendor_hal_qteeconnector_server:fd { use };
