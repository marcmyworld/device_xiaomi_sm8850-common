# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_visdisplaysrv_server hal_graphics_composer_default:binder { transfer };
allow hal_visdisplaysrv_server hal_visdisplaysrv_client:binder { call transfer };
allow hal_visdisplaysrv_server hal_visdisplaysrv_client:binder { transfer };
allow hal_visdisplaysrv_server hal_visdisplaysrv_client:fd { use };
allow hal_visdisplaysrv_server hal_visdisplaysrv_service:service_manager { add find };
allow hal_visdisplaysrv_server servicemanager:binder { call transfer };
allow hal_visdisplaysrv_server servicemanager:fd { use };
