# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_ozonotify_default, domain, hal_ozonotify, hal_ozonotify_server, halserverdomain;
type hal_ozonotify_default_exec, exec_type, file_type, vendor_file_type;

allow hal_ozonotify_default hal_ozonotify_default_exec:file { read getattr map execute open entrypoint };
