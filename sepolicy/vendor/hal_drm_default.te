# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_drm_default hal_codec2_server:fd { use };
allow hal_drm_default hal_drm_default_exec:file { read getattr map execute open entrypoint };
allow hal_drm_default hal_omx_server:fd { use };
allow hal_drm_default vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
