# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_cs_app app_api_service:service_manager { find };
allow vendor_cs_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_cs_app proc_cpuinfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_cs_app proc_meminfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_cs_app radio_service:service_manager { find };
allow vendor_cs_app self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_cs_app surfaceflinger_service:service_manager { find };
allow vendor_cs_app vendor_cs_app_userfaultfd:anon_inode { ioctl read create };
allow vendor_cs_app vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_cs_app vendor_mlid:unix_stream_socket { connectto };
allow vendor_cs_app vendor_mlid_socket:sock_file { write };
allow vendor_cs_app vendor_ssgqmig_socket:sock_file { write };
allow vendor_cs_app vendor_ssgqmigd:unix_stream_socket { connectto };
allow vendor_cs_app vendor_ssgtzd:unix_stream_socket { connectto };
allow vendor_cs_app vendor_ssgtzd_socket:sock_file { write };
allowxperm vendor_cs_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
