# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_xrcommd init:unix_stream_socket { connectto };
allow vendor_xrcommd property_socket:sock_file { write };
allow vendor_xrcommd self:netlink_route_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_xrcommd self:udp_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_xrcommd sysfs_net:dir { read search };
allow vendor_xrcommd sysfs_net:file { read open };
allow vendor_xrcommd vendor_hal_xrcommservice_qti_socket_client:fd { use };
allow vendor_xrcommd vendor_hal_xrcommservice_qti_socket_client:unix_stream_socket { read write shutdown };
allow vendor_xrcommd vendor_xrcomm_prop:file { read getattr map open };
allow vendor_xrcommd vendor_xrcomm_prop:property_service { set };
allow vendor_xrcommd vendor_xrcommd_exec:file { read getattr map execute open entrypoint };
allow vendor_xrcommd vendor_xrcommd_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_xrcommd vendor_xrcommd_vndr_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_xrcommd vendor_xrcommd_vndr_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
