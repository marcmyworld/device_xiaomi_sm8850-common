# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_npu_monitor vendor_npu_monitor_exec:file { read getattr map execute open entrypoint };
allow vendor_npu_monitor vendor_sysfs_npu_pids_remote_sessions:file { ioctl read getattr lock map open watch watch_reads };
