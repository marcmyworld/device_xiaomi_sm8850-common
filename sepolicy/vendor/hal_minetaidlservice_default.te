# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_minetaidlservice_default, domain, hal_minetaidlservice, hal_minetaidlservice_server, hal_miwillservice, hal_miwillservice_server, hal_slaaidlservice, hal_slaaidlservice_server, halserverdomain;
type hal_minetaidlservice_default_exec, exec_type, file_type, vendor_file_type;

allow hal_minetaidlservice_default hal_minetaidlservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_minetaidlservice_default hal_minetaidlservice_sub:process { siginh rlimitinh };
allow hal_minetaidlservice_default hal_minetaidlservice_sub:process { transition };
allow hal_minetaidlservice_default init:unix_stream_socket { connectto };
allow hal_minetaidlservice_default minetd:unix_stream_socket { connectto };
allow hal_minetaidlservice_default minetd_socket:sock_file { read write getattr unlink };
allow hal_minetaidlservice_default property_socket:sock_file { write };
allow hal_minetaidlservice_default slad:unix_stream_socket { connectto };
allow hal_minetaidlservice_default slad_socket:sock_file { write };
allow hal_minetaidlservice_default socket_device:sock_file { write };
allow hal_minetaidlservice_default system_app:binder { call };
allow hal_minetaidlservice_default system_server:binder { call };
allow hal_minetaidlservice_default vendor_minetd_prop:file { read getattr map open };
allow hal_minetaidlservice_default vendor_minetd_prop:file { read };
allow hal_minetaidlservice_default vendor_minetd_prop:property_service { set };
allow hal_minetaidlservice_default vendor_shell_exec:file { read getattr map execute open };
allow hal_minetaidlservice_default vendor_slad_prop:file { read getattr map open };
allow hal_minetaidlservice_default vendor_slad_prop:property_service { set };
allow hal_minetaidlservice_default vendor_system_prop:file { read getattr map open };
allow hal_minetaidlservice_default vendor_wlan_chip_prop:file { read getattr map open };
dontaudit hal_minetaidlservice_default hal_minetaidlservice_sub:process { noatsecure };
type_transition hal_minetaidlservice_default vendor_shell_exec:process hal_minetaidlservice_sub;
