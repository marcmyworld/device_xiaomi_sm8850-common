# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_wigignpt hwservicemanager:binder { call transfer };
allow vendor_wigignpt hwservicemanager_prop:file { read getattr map open };
allow vendor_wigignpt system_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_wigignpt vendor_wigignpt_exec:file { read getattr map execute open entrypoint };
