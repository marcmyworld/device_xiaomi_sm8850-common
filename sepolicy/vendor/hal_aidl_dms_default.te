# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_aidl_dms_default, domain, hal_aidl_dms, hal_aidl_dms_server, hal_mediaeventgatherservice_client, halclientdomain, halserverdomain;
type hal_aidl_dms_default_exec, exec_type, file_type, vendor_file_type;

allow hal_aidl_dms_default hal_aidl_dms_default_exec:file { read getattr map execute open entrypoint };
allow hal_aidl_dms_default hal_mediaeventgatherservice:binder { call };
allow hal_aidl_dms_default hal_mediaeventgatherservice_service:fd { use };
allow hal_aidl_dms_default hal_mediaeventgatherservice_service:service_manager { find };
allow hal_aidl_dms_default init:unix_stream_socket { connectto };
allow hal_aidl_dms_default property_socket:sock_file { write };
allow hal_aidl_dms_default vendor_audio_prop:file { read getattr map open };
allow hal_aidl_dms_default vendor_audio_prop:property_service { set };
allow hal_aidl_dms_default vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_aidl_dms_default vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
