# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_mtdservice_default, domain, hal_idmanager_client, hal_keymint_client, hal_mfidoca_client, hal_mlipay_client, hal_mtdservice, hal_mtdservice_server, hal_secure_element_client, halclientdomain, halserverdomain, vendor_hal_soter_client;
type hal_mtdservice_default_exec, exec_type, file_type, vendor_file_type;

allow hal_mtdservice_default block_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_mtdservice_default firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_mtdservice_default firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_mtdservice_default hal_mtdservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_mtdservice_default hal_mtkeysoter_default:binder { call transfer };
allow hal_mtdservice_default hal_mtkeysoter_default:binder { transfer };
allow hal_mtdservice_default hal_mtkeysoter_default:fd { use };
allow hal_mtdservice_default hal_mtkeysoter_service:service_manager { find };
allow hal_mtdservice_default hal_tidaservice_default:binder { transfer };
allow hal_mtdservice_default init:unix_stream_socket { connectto };
allow hal_mtdservice_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_mtdservice_default mnt_vendor_file:dir { ioctl read write create getattr setattr lock relabelfrom rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_mtdservice_default nfc_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_mtdservice_default proc:file { ioctl read getattr lock map open watch watch_reads };
allow hal_mtdservice_default property_socket:sock_file { write };
allow hal_mtdservice_default self:qipcrtr_socket { read write create getattr setopt };
allow hal_mtdservice_default servicemanager:binder { call transfer };
allow hal_mtdservice_default sysfs:dir { read open };
allow hal_mtdservice_default sysfs:file { read write open };
allow hal_mtdservice_default system_data_file:dir { getattr };
allow hal_mtdservice_default ta_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_mtdservice_default ta_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_mtdservice_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_mtdservice_default vendor_cpuid_prop:file { read getattr map open };
allow hal_mtdservice_default vendor_deviceid_prop:file { read getattr map open };
allow hal_mtdservice_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read open };
allow hal_mtdservice_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read open };
allow hal_mtdservice_default vendor_ese_gpio_device:chr_file { ioctl read write open };
allow hal_mtdservice_default vendor_hal_soter_qti:binder { call transfer };
allow hal_mtdservice_default vendor_hal_soter_qti:fd { use };
allow hal_mtdservice_default vendor_payment_security_prop:file { read getattr map open };
