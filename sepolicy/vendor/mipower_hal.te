# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type mipower_hal, domain;
type mipower_hal_exec, exec_type, file_type, vendor_file_type;

allow mipower_hal mipower_hal_exec:file { read getattr execute open };
allow mipower_hal mipower_hal_exec:file { read getattr map execute open entrypoint };
allow mipower_hal power_hal_socket:sock_file { read write getattr unlink };
allow mipower_hal self:capability { net_admin };
allow mipower_hal self:netlink_generic_socket { read write create getattr bind setopt };
allow mipower_hal self:netlink_tcpdiag_socket { read write create setopt nlmsg_read };
allow mipower_hal self:process { execmem };
allow mipower_hal self:udp_socket { ioctl read create };
allow mipower_hal socket_device:dir { write create add_name remove_name };
allow mipower_hal socket_device:sock_file { write create setattr unlink };
allow mipower_hal sysfs:file { read open };
allow mipower_hal vendor_system_prop:file { read getattr map open };
allow mipower_hal vendor_wcnss_service:unix_stream_socket { connectto };
allow mipower_hal vendor_wlan_chip_prop:file { read getattr map open };
