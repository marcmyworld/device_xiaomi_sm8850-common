# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_power_stats_default hal_power_stats_default_exec:file { read getattr map execute open entrypoint };
allow hal_power_stats_default vendor_power_stats_enhance:file { read getattr map open };
allow hal_power_stats_default vendor_sysfs_powercap:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_power_stats_default vendor_sysfs_powercap:file { ioctl read getattr lock map open watch watch_reads };
allow hal_power_stats_default vendor_sysfs_powercap:file { write lock append map open };
