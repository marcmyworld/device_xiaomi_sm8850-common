# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_idmanager_client hal_idmanager_server:binder { call transfer };
allow hal_idmanager_client hal_idmanager_server:fd { use };
allow hal_idmanager_client hal_idmanager_service:service_manager { find };
