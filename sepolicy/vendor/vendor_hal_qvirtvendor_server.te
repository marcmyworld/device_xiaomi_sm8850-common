# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qvirtvendor_server vendor_hal_qvirtvendor_client:binder { call transfer };
allow vendor_hal_qvirtvendor_server vendor_hal_qvirtvendor_client:binder { transfer };
allow vendor_hal_qvirtvendor_server vendor_hal_qvirtvendor_client:fd { use };
allow vendor_hal_qvirtvendor_server vendor_hal_qvirtvendor_service:service_manager { add find };
