# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qcomsysd anr_data_file:file { append };
allow vendor_qcomsysd block_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qcomsysd dumpstate:fd { use };
allow vendor_qcomsysd dumpstate:fifo_file { write append };
allow vendor_qcomsysd incidentd:fd { use };
allow vendor_qcomsysd incidentd:fifo_file { write append };
allow vendor_qcomsysd init:unix_stream_socket { connectto };
allow vendor_qcomsysd powerctl_prop:file { read getattr map open };
allow vendor_qcomsysd powerctl_prop:property_service { set };
allow vendor_qcomsysd property_socket:sock_file { write };
allow vendor_qcomsysd self:capability { sys_boot };
allow vendor_qcomsysd self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_qcomsysd self:socket { create };
allow vendor_qcomsysd system_server:fifo_file { write append };
allow vendor_qcomsysd tombstone_data_file:file { append };
allow vendor_qcomsysd tombstoned:fd { use };
allow vendor_qcomsysd tombstoned:unix_stream_socket { connectto };
allow vendor_qcomsysd tombstoned_crash_socket:sock_file { write };
allow vendor_qcomsysd vendor_boot_mode_prop:file { read getattr map open };
allow vendor_qcomsysd vendor_boot_mode_prop:property_service { set };
allow vendor_qcomsysd vendor_diag_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qcomsysd vendor_per_mgr:binder { call transfer };
allow vendor_qcomsysd vendor_per_mgr:binder { transfer };
allow vendor_qcomsysd vendor_per_mgr:fd { use };
allow vendor_qcomsysd vendor_per_mgr_service:service_manager { find };
allow vendor_qcomsysd vendor_per_mgr_state_prop:file { read getattr map open };
allow vendor_qcomsysd vendor_qcomsysd_exec:file { read getattr map execute open entrypoint };
allow vendor_qcomsysd vendor_smem_log_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_diag:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qcomsysd vendor_sysfs_diag:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_diag:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_qdss_dev:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qcomsysd vendor_sysfs_qdss_dev:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_soc:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qcomsysd vendor_sysfs_soc:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qcomsysd vendor_sysfs_soc:file { write lock append map open };
allow vendor_qcomsysd vendor_sysfs_soc:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qcomsysd vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qcomsysd vndservicemanager:binder { call transfer };
