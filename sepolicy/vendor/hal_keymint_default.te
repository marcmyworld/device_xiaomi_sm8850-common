# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_keymint_default hal_keymint_default_exec:file { read getattr map execute open entrypoint };
allow hal_keymint_default vendor_security_patch_level_prop:file { read getattr map open };
