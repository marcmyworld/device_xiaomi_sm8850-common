# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow update_engine fuse:dir { ioctl read getattr lock open watch watch_reads search };
allow update_engine loop_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine misc_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine proc_bootconfig:file { ioctl read getattr lock map open watch watch_reads };
allow update_engine sdcard_type:dir { ioctl read getattr lock open watch watch_reads search };
allow update_engine sdcard_type:file { ioctl read getattr lock map open watch watch_reads };
allow update_engine storage_file:dir { ioctl read getattr lock open watch watch_reads search };
allow update_engine storage_file:file { ioctl read getattr lock map open watch watch_reads };
allow update_engine system_app:binder { call transfer };
allow update_engine system_app:binder { transfer };
allow update_engine system_app:fd { use };
allow update_engine vendor_vm_file:dir { search };
allow update_engine vendor_vm_system_file:dir { search };
