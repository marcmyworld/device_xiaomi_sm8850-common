# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_systemhelper_app vendor_hal_trustedui_qti:binder { call transfer };
allow vendor_systemhelper_app vendor_hal_trustedui_qti:binder { transfer };
allow vendor_systemhelper_app vendor_hal_trustedui_qti:fd { use };
