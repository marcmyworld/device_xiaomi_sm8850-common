# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_init_xrcommd_shell self:capability { net_admin };
allow vendor_init_xrcommd_shell self:udp_socket { ioctl create };
allow vendor_init_xrcommd_shell vendor_init_xrcommd_shell_exec:file { read getattr map execute open entrypoint };
allow vendor_init_xrcommd_shell vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_init_xrcommd_shell vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allowxperm vendor_init_xrcommd_shell self:udp_socket ioctl { 0x8922 };
