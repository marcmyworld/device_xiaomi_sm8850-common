# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_health hal_health_default:dir { search };
allow hal_health vendor_display_prop:file { read getattr map open };
allow hal_health vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_health vendor_sysfs_battery_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_health vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_health vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_health vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_health vendor_sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_health vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_health vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_health vendor_sysfs_xm_power:dir { search };
allow hal_health vendor_sysfs_xm_power:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_health vendor_sysfs_xm_power:file { read write open };
dontaudit hal_health default_prop:file { read };
