# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_iwlanservice_qti_server vendor_hal_iwlan_service:service_manager { add find };
allow vendor_hal_iwlanservice_qti_server vendor_hal_iwlanservice_qti_client:binder { call transfer };
allow vendor_hal_iwlanservice_qti_server vendor_hal_iwlanservice_qti_client:binder { transfer };
allow vendor_hal_iwlanservice_qti_server vendor_hal_iwlanservice_qti_client:fd { use };
