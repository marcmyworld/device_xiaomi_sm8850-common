# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mipowerservice_server hal_mipowerhalservice_service:service_manager { add find };
allow hal_mipowerservice_server hal_mipowerservice_client:binder { call transfer };
allow hal_mipowerservice_server hal_mipowerservice_client:binder { transfer };
allow hal_mipowerservice_server hal_mipowerservice_client:fd { use };
allow hal_mipowerservice_server servicemanager:binder { call transfer };
allow hal_mipowerservice_server servicemanager:fd { use };
