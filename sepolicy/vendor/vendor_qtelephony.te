# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qtelephony vendor_atfwd:binder { transfer };
allow vendor_qtelephony vendor_audio_prop:file { read getattr map open };
allow vendor_qtelephony vendor_hal_imsrtp:binder { transfer };
allow vendor_qtelephony vendor_ims_prop:file { read getattr map open };
allow vendor_qtelephony vendor_persist_camera_prop:file { read getattr map open };
allow vendor_qtelephony vendor_radio_prop:file { read getattr map open };
allow vendor_qtelephony vendor_video_prop:file { read getattr map open };
dontaudit vendor_qtelephony vendor_hal_qspmhal_service:service_manager { find };
