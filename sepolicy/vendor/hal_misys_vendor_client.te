# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_misys_vendor_client hal_misys_vendor_server:binder { call transfer };
allow hal_misys_vendor_client hal_misys_vendor_server:binder { transfer };
allow hal_misys_vendor_client hal_misys_vendor_server:fd { use };
allow hal_misys_vendor_client hal_misys_vendor_service:service_manager { find };
