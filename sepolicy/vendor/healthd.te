# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow healthd self:capability2 { wake_alarm };
allow healthd sysfs_thermal:dir { ioctl read getattr lock open watch watch_reads search };
allow healthd sysfs_thermal:file { ioctl read getattr lock map open watch watch_reads };
allow healthd sysfs_thermal:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow healthd vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow healthd vendor_sysfs_battery_supply:file { ioctl read getattr lock map open watch watch_reads };
allow healthd vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow healthd vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow healthd vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow healthd vendor_sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow healthd vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow healthd vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
