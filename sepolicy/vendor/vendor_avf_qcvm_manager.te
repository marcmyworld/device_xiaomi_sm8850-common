# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_avf_qcvm_manager block_device:dir { search };
allow vendor_avf_qcvm_manager early_virtmgr_exec:file { read getattr map execute open };
allow vendor_avf_qcvm_manager hypervisor_prop:file { read getattr map open };
allow vendor_avf_qcvm_manager mnt_vendor_file:dir { search };
allow vendor_avf_qcvm_manager mnt_vendor_vm_file:dir { search };
allow vendor_avf_qcvm_manager mnt_vendor_vm_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_avf_qcvm_manager self:netlink_kobject_uevent_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_avf_qcvm_manager self:vsock_socket { read write create bind connect listen accept setopt };
allow vendor_avf_qcvm_manager servicemanager:binder { call transfer };
allow vendor_avf_qcvm_manager vendor_avf_qcvm_manager_exec:file { read getattr map execute open entrypoint };
allow vendor_avf_qcvm_manager vendor_avf_qcvm_manager_gunyah_cmafd:anon_inode { read create getattr };
allow vendor_avf_qcvm_manager vendor_custom_ab_block_device:blk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_avf_qcvm_manager vendor_hlos_minkd_opener_socket:sock_file { write };
allow vendor_avf_qcvm_manager vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_avf_qcvm_manager vendor_qcvm_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_avf_qcvm_manager vendor_vm_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_avf_qcvm_manager vendor_vm_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_avf_qcvm_manager vendor_vm_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_avf_qcvm_manager vendor_vm_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_avf_qcvm_manager vendor_vm_ssrenable_prop:file { read getattr map open };
allow vendor_avf_qcvm_manager virtualizationmanager_exec:file { read getattr map execute open };
