# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_misecmedia_server dumpstate:fd { use };
allow hal_misecmedia_server dumpstate:fifo_file { write };
allow hal_misecmedia_server hal_misecmedia_client:binder { call transfer };
allow hal_misecmedia_server hal_misecmedia_client:binder { transfer };
allow hal_misecmedia_server hal_misecmedia_client:fd { use };
allow hal_misecmedia_server hal_misecmedia_service:service_manager { add find };
allow hal_misecmedia_server servicemanager:binder { call transfer };
allow hal_misecmedia_server servicemanager:fd { use };
