# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow ot_rcp devpts:chr_file { ioctl read write };
allow ot_rcp hal_threadnetwork_default:fd { use };
allow ot_rcp hal_threadnetwork_default:fifo_file { ioctl read write getattr lock append map open watch watch_reads };
allow ot_rcp hal_threadnetwork_default:process { sigchld };
allow ot_rcp node:udp_socket { node_bind };
allow ot_rcp ot_rcp_exec:file { read getattr map execute open entrypoint };
allow ot_rcp port:udp_socket { name_bind };
allow ot_rcp self:netlink_route_socket { read write create nlmsg_read nlmsg_readpriv };
allow ot_rcp self:udp_socket { ioctl read write create bind setopt };
