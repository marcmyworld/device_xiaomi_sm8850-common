# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_miguardca_client hal_miguardca_server:binder { call transfer };
allow hal_miguardca_client hal_miguardca_server:fd { use };
allow hal_miguardca_client hal_miguardca_service:service_manager { find };
