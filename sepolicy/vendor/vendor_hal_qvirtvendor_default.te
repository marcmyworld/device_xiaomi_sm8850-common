# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qvirtvendor_default servicemanager:binder { call transfer };
allow vendor_hal_qvirtvendor_default vendor_hal_qvirtvendor_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_qvirtvendor_default vendor_hlos_minkd_opener_socket:sock_file { write };
allow vendor_hal_qvirtvendor_default vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_hal_qvirtvendor_default vendor_vm_ssrenable_prop:file { read getattr map open };
