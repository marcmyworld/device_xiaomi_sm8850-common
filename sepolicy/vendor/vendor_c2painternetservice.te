# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_c2painternetservice vendor_c2painternetservice_exec:file { read getattr map execute open entrypoint };
allow vendor_c2painternetservice vendor_hlos_minkd_opener_socket:sock_file { write };
allow vendor_c2painternetservice vendor_hlosminkdaemon:unix_stream_socket { connectto };
