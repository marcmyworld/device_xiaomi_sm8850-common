# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_miguardca_server hal_miguardca_client:binder { transfer };
allow hal_miguardca_server hal_miguardca_service:service_manager { add find };
allow hal_miguardca_server servicemanager:binder { call transfer };
allow hal_miguardca_server servicemanager:fd { use };
