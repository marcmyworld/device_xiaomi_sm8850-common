# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_wifilearner self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hal_wifilearner servicemanager:binder { call transfer };
allow vendor_hal_wifilearner servicemanager:fd { use };
