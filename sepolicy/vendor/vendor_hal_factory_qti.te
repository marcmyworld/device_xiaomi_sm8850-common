# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_factory_qti init:unix_stream_socket { connectto };
allow vendor_hal_factory_qti property_socket:sock_file { write };
allow vendor_hal_factory_qti servicemanager:binder { call transfer };
allow vendor_hal_factory_qti servicemanager:fd { use };
allow vendor_hal_factory_qti vendor_ctl_vendor_mmid_prop:file { read getattr map open };
allow vendor_hal_factory_qti vendor_ctl_vendor_mmid_prop:property_service { set };
allow vendor_hal_factory_qti vendor_mmi:unix_stream_socket { connectto };
allow vendor_hal_factory_qti vendor_mmi_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
