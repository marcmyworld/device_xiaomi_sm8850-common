# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_atrace_default debugfs_tracing:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_atrace_default debugfs_tracing:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_atrace_default hal_atrace_default_exec:file { read getattr map execute open entrypoint };
