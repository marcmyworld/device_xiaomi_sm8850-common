# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_uniperf_server hal_uniperf_client:binder { call transfer };
allow hal_uniperf_server hal_uniperf_client:binder { transfer };
allow hal_uniperf_server hal_uniperf_client:fd { use };
allow hal_uniperf_server hal_uniperf_service:service_manager { add find };
allow hal_uniperf_server servicemanager:binder { call transfer };
allow hal_uniperf_server servicemanager:fd { use };
