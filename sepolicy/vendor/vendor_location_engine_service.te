# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_location_engine_service self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_location_engine_service system_server:binder { transfer };
allow vendor_location_engine_service vendor_hal_gnss_qti:unix_dgram_socket { sendto };
allow vendor_location_engine_service vendor_location:fd { use };
allow vendor_location_engine_service vendor_location:process { sigchld };
allow vendor_location_engine_service vendor_location:unix_dgram_socket { read write sendto };
allow vendor_location_engine_service vendor_location_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_location_engine_service vendor_location_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_location_engine_service vendor_location_engine_service_exec:file { read getattr map execute open entrypoint };
allow vendor_location_engine_service vendor_location_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_location_engine_service vendor_location_socket:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_location_engine_service vendor_location_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
