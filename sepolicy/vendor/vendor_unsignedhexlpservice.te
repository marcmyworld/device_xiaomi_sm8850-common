# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_unsignedhexlpservice anr_data_file:file { append };
allow vendor_unsignedhexlpservice boot_status_prop:file { read getattr map open };
allow vendor_unsignedhexlpservice dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_unsignedhexlpservice dumpstate:fd { use };
allow vendor_unsignedhexlpservice dumpstate:fifo_file { write append };
allow vendor_unsignedhexlpservice incidentd:fd { use };
allow vendor_unsignedhexlpservice incidentd:fifo_file { write append };
allow vendor_unsignedhexlpservice servicemanager:binder { call transfer };
allow vendor_unsignedhexlpservice servicemanager:fd { use };
allow vendor_unsignedhexlpservice sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_unsignedhexlpservice system_server:fifo_file { write append };
allow vendor_unsignedhexlpservice tombstone_data_file:file { append };
allow vendor_unsignedhexlpservice tombstoned:fd { use };
allow vendor_unsignedhexlpservice tombstoned:unix_stream_socket { connectto };
allow vendor_unsignedhexlpservice tombstoned_crash_socket:sock_file { write };
allow vendor_unsignedhexlpservice vendor_adsprpc_prop:file { read getattr map open };
allow vendor_unsignedhexlpservice vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_unsignedhexlpservice vendor_hexlpservice_exec:file { read getattr map execute open entrypoint };
allow vendor_unsignedhexlpservice vendor_qdsp_device:chr_file { ioctl read };
allow vendor_unsignedhexlpservice vendor_synx_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_unsignedhexlpservice vendor_unsignedhexlp_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_unsignedhexlpservice vendor_unsignedhexlp_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
dontaudit vendor_unsignedhexlpservice vendor_qdsp_device:chr_file { open };
dontaudit vendor_unsignedhexlpservice vendor_xdsp_device:chr_file { read getattr map open };
