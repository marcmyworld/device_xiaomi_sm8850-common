# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_bootctl_server misc_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl_server self:capability { sys_rawio };
