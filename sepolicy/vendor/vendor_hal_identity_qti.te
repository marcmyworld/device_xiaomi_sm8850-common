# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_identity_qti ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_identity_qti tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_identity_qti vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_identity_qti vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_identity_qti vendor_hal_identity_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_identity_qti vendor_tee_listener_prop:file { read getattr map open };
dontaudit vendor_hal_identity_qti firmware_file:dir { search };
