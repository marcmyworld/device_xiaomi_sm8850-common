# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_display_aiqe_server vendor_hal_display_aiqe_aidl_service:service_manager { add find };
allow vendor_hal_display_aiqe_server vendor_hal_display_aiqe_client:binder { transfer };
