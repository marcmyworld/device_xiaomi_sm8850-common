# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_bluetooth_dun_qti vendor_hal_bluetooth_dun_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_bluetooth_dun_qti vendor_port-bridge:unix_stream_socket { connectto };
allow vendor_hal_bluetooth_dun_qti vendor_port-bridge_socket:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_bluetooth_dun_qti vendor_port-bridge_socket:sock_file { read write };
allow vendor_hal_bluetooth_dun_qti vendor_port-bridge_socket:sock_file { write };
