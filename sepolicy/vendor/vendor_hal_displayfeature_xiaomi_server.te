# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_displayfeature_xiaomi_server vendor_hal_displayfeature_xiaomi_client:binder { transfer };
allow vendor_hal_displayfeature_xiaomi_server vendor_hal_displayfeature_xiaomi_service:service_manager { add find };
allow vendor_hal_displayfeature_xiaomi_server vendor_hal_framecapturemanager_xiaomi_service:service_manager { add find };
allow vendor_hal_displayfeature_xiaomi_server vendor_hal_framemaster_xiaomi_service:service_manager { add find };
