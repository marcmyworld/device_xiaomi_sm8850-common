# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_gnss self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_gnss vendor_per_mgr:binder { transfer };
