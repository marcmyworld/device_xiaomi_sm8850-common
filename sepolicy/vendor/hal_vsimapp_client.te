# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_vsimapp_client hal_vsimapp_server:binder { call transfer };
allow hal_vsimapp_client hal_vsimapp_server:binder { transfer };
allow hal_vsimapp_client hal_vsimapp_server:fd { use };
allow hal_vsimapp_client hal_vsimapp_service:service_manager { find };
