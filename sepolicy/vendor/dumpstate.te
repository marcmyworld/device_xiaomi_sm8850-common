# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute dumpstate hal_seaaudio_client;
typeattribute dumpstate hal_mediaeventgatherservice_client;
typeattribute dumpstate hal_mrm_client;
typeattribute dumpstate hal_misys_vendor_client;
typeattribute dumpstate hal_miface_client;
typeattribute dumpstate hal_ozonotify_client;
typeattribute dumpstate hal_misyscore_client;
typeattribute dumpstate hal_mseccam_client;
typeattribute dumpstate hal_misecmedia_client;
typeattribute dumpstate hal_micrtk_client;

allow dumpstate adsprpcd_file:dir { getattr };
allow dumpstate bt_firmware_file:dir { getattr };
allow dumpstate bt_firmware_file:filesystem { getattr };
allow dumpstate debugfs_mmc:dir { search };
allow dumpstate firmware_file:dir { getattr };
allow dumpstate firmware_file:filesystem { getattr };
allow dumpstate hal_bluetooth_default:binder { call transfer };
allow dumpstate hal_bluetooth_default:fd { use };
allow dumpstate hal_dumpstate_default:binder { call transfer };
allow dumpstate hal_dumpstate_default:fd { use };
allow dumpstate hal_light_default:binder { call transfer };
allow dumpstate hal_light_default:fd { use };
allow dumpstate hal_mediaeventgatherservice_default:binder { call };
allow dumpstate hal_mediaeventgatherservice_default:binder { transfer };
allow dumpstate hal_midevauth_default:binder { call };
allow dumpstate hal_midevauth_default:binder { transfer };
allow dumpstate hal_ozonotify_default:binder { call };
allow dumpstate hal_ozonotify_default:binder { transfer };
allow dumpstate hal_ozonotify_hwservice:hwservice_manager { find };
allow dumpstate hal_power_default:binder { call transfer };
allow dumpstate hal_power_default:fd { use };
allow dumpstate hal_seaaudio_default:binder { call };
allow dumpstate hal_seaaudio_default:binder { transfer };
allow dumpstate hal_uwb:binder { call transfer };
allow dumpstate hal_uwb:fd { use };
allow dumpstate hal_videoservice_default:binder { call transfer };
allow dumpstate hal_videoservice_default:fd { use };
allow dumpstate hal_videoservice_default:process { signal };
allow dumpstate minidump_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow dumpstate mnt_vendor_vm_file:filesystem { getattr };
allow dumpstate proc:dir { ioctl read getattr lock open watch watch_reads search };
allow dumpstate procfs_memory:dir { ioctl read getattr lock open watch watch_reads search };
allow dumpstate procfs_memory:file { ioctl read getattr lock map open watch watch_reads };
allow dumpstate sysfs_bootinfo:file { ioctl read getattr lock map open watch watch_reads };
allow dumpstate sysfs_memory:dir { ioctl read getattr lock open watch watch_reads search };
allow dumpstate sysfs_memory:file { ioctl read getattr lock map open watch watch_reads };
allow dumpstate vendor_hal_displayfeature_xiaomi_default:binder { call transfer };
allow dumpstate vendor_hal_displayfeature_xiaomi_default:fd { use };
allow dumpstate vendor_miface_prop:file { read getattr map open };
allow dumpstate vendor_proc_mimdlog:file { ioctl read getattr lock map open watch watch_reads };
allow dumpstate vendor_proc_perflock_records:file { ioctl read getattr lock map open watch watch_reads };
allow dumpstate vendor_qms:binder { call transfer };
allow dumpstate vendor_qms:fd { use };
allow dumpstate vendor_soccp_file:dir { getattr };
allow dumpstate vendor_soccp_file:filesystem { getattr };
allow dumpstate vendor_vm_file:dir { getattr };
allow dumpstate vendor_vm_system_file:dir { getattr };
allow dumpstate vendor_vm_system_file:filesystem { getattr };
dontaudit dumpstate sysfs:file { ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads execute_no_trans entrypoint };
