# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_secureprocessor_qti self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hal_secureprocessor_qti tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_dmabuf_display_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_hal_secureprocessor_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_secureprocessor_qti vendor_hlos_minkd_opener_socket:sock_file { write };
allow vendor_hal_secureprocessor_qti vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_hal_secureprocessor_qti vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_secureprocessor_start_prop:file { read getattr map open };
allow vendor_hal_secureprocessor_qti vendor_vm_oem_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_vm_self_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_secureprocessor_qti vendor_vm_ssrenable_prop:file { read getattr map open };
allow vendor_hal_secureprocessor_qti vendor_vm_trusted_device:chr_file { ioctl read getattr lock map open watch watch_reads };
