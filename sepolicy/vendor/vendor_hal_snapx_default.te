# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_snapx_default servicemanager:binder { call transfer };
allow vendor_hal_snapx_default servicemanager:fd { use };
allow vendor_hal_snapx_default vendor_hal_qesdhal_client:binder { call transfer };
allow vendor_hal_snapx_default vendor_hal_qesdhal_client:fd { use };
allow vendor_hal_snapx_default vendor_hal_snapx_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_snapx_default vendor_qesdk_service:service_manager { find };
