# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_miqms_server hal_miqms_client:binder { call transfer };
allow hal_miqms_server hal_miqms_client:binder { transfer };
allow hal_miqms_server hal_miqms_client:fd { use };
allow hal_miqms_server hal_miqms_service:service_manager { add find };
allow hal_miqms_server servicemanager:binder { call transfer };
allow hal_miqms_server servicemanager:fd { use };
