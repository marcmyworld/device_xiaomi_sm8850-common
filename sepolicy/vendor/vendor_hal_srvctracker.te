# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_srvctracker hidl_base_hwservice:hwservice_manager { add };
allow vendor_hal_srvctracker hwservicemanager:binder { call };
allow vendor_hal_srvctracker vendor_hal_srvctracker_hwservice:hwservice_manager { add find };
