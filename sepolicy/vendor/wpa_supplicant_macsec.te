# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow wpa_supplicant_macsec cgroup:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow wpa_supplicant_macsec cgroup_v2:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow wpa_supplicant_macsec proc_net_type:dir { ioctl read getattr lock open watch watch_reads search };
allow wpa_supplicant_macsec proc_net_type:file { ioctl read getattr lock map open watch watch_reads };
allow wpa_supplicant_macsec proc_net_type:file { write };
allow wpa_supplicant_macsec proc_net_type:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow wpa_supplicant_macsec self:cap_userns { setgid setuid net_admin net_raw };
allow wpa_supplicant_macsec self:capability { setgid setuid net_admin net_raw };
allow wpa_supplicant_macsec self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow wpa_supplicant_macsec self:netlink_route_socket { nlmsg_write };
allow wpa_supplicant_macsec self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow wpa_supplicant_macsec self:packet_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow wpa_supplicant_macsec servicemanager:binder { call transfer };
allow wpa_supplicant_macsec sysfs_type:dir { ioctl read getattr lock open watch watch_reads search };
allow wpa_supplicant_macsec sysfs_type:file { ioctl read getattr lock map open watch watch_reads };
allow wpa_supplicant_macsec sysfs_type:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow wpa_supplicant_macsec wpa_supplicant_macsec_exec:file { read getattr map execute open entrypoint };
