# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_factory_qti_default init:unix_stream_socket { connectto };
allow vendor_hal_factory_qti_default mnt_vendor_file:dir { search };
allow vendor_hal_factory_qti_default property_socket:sock_file { write };
allow vendor_hal_factory_qti_default vendor_boot_mode_prop:file { read getattr map open };
allow vendor_hal_factory_qti_default vendor_boot_mode_prop:property_service { set };
allow vendor_hal_factory_qti_default vendor_hal_factory_qti_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_factory_qti_default vendor_persist_mmi_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_factory_qti_default vendor_persist_mmi_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
