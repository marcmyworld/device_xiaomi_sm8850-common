# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_perf_qesdk servicemanager:binder { call transfer };
allow vendor_perf_qesdk vendor_hal_qesdhal:unix_stream_socket { connectto };
allow vendor_perf_qesdk vendor_perf_qesdk_exec:file { read getattr map execute open entrypoint };
allow vendor_perf_qesdk vendor_qesd_socket:sock_file { write };
allow vendor_perf_qesdk vendor_qlm_service:unix_stream_socket { connectto };
allow vendor_perf_qesdk vendor_qlm_socket:sock_file { write };
