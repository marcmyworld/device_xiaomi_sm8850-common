# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hvdcp hal_system_suspend_service:service_manager { find };
allow vendor_hvdcp hidl_manager_hwservice:hwservice_manager { find };
allow vendor_hvdcp hwservicemanager:binder { call transfer };
allow vendor_hvdcp hwservicemanager_prop:file { read getattr map open };
allow vendor_hvdcp init:unix_stream_socket { connectto };
allow vendor_hvdcp mnt_vendor_file:dir { search };
allow vendor_hvdcp property_socket:sock_file { write };
allow vendor_hvdcp self:cap2_userns { block_suspend };
allow vendor_hvdcp self:capability2 { block_suspend };
allow vendor_hvdcp self:capability2 { wake_alarm };
allow vendor_hvdcp self:netlink_kobject_uevent_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hvdcp servicemanager:binder { call transfer };
allow vendor_hvdcp sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp system_suspend_hwservice:hwservice_manager { find };
allow vendor_hvdcp system_suspend_server:binder { call transfer };
allow vendor_hvdcp system_suspend_server:fd { use };
allow vendor_hvdcp vendor_hvdcp_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_hvdcp_exec:file { read getattr map execute open entrypoint };
allow vendor_hvdcp vendor_hvdcp_opti_prop:file { read getattr map open };
allow vendor_hvdcp vendor_hvdcp_opti_prop:property_service { set };
allow vendor_hvdcp vendor_persist_hvdcp_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hvdcp vendor_persist_hvdcp_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hvdcp vendor_qg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hvdcp vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_spmi_dev:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hvdcp vendor_sysfs_spmi_dev:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_spmi_dev:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hvdcp vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_usbpd_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hvdcp vendor_sysfs_usbpd_device:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hvdcp vendor_sysfs_vadc_dev:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hvdcp vendor_sysfs_vadc_dev:file { ioctl read write getattr lock append map open watch watch_reads };
