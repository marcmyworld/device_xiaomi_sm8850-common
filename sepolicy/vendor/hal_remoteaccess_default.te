# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_remoteaccess_default hal_remoteaccess_default_exec:file { read getattr map execute open entrypoint };
allow hal_remoteaccess_default servicemanager:binder { call transfer };
allow hal_remoteaccess_default servicemanager:fd { use };
