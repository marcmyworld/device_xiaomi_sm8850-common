# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mediaeventgatherservice_server dumpstate:fd { use };
allow hal_mediaeventgatherservice_server dumpstate:fifo_file { write };
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_client:binder { call transfer };
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_client:binder { transfer };
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_client:fd { use };
allow hal_mediaeventgatherservice_server hal_mediaeventgatherservice_service:service_manager { add find };
