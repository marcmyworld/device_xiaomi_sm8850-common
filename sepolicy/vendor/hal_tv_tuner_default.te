# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_tv_tuner_default dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_tv_tuner_default hal_tv_tuner_default_exec:file { read getattr map execute open entrypoint };
allow hal_tv_tuner_default ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_tv_tuner_default servicemanager:binder { call transfer };
