# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_bootctl block_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bootctl boot_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bootctl recovery_block_device:blk_file { getattr };
allow hal_bootctl root_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl sysfs_dt_firmware_android:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bootctl system_block_device:blk_file { getattr };
allow hal_bootctl vendor_ab_block_device:blk_file { getattr };
allow hal_bootctl vendor_bsg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl vendor_custom_ab_block_device:blk_file { getattr };
allow hal_bootctl vendor_gpt_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl vendor_mdtp_device:blk_file { getattr };
allow hal_bootctl vendor_modem_block_device:blk_file { getattr };
allow hal_bootctl vendor_sg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bootctl vendor_sysfs_scsi_target:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bootctl vendor_xbl_block_device:blk_file { getattr };
allow hal_bootctl vendor_xbl_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
dontaudit hal_bootctl self:capability { sys_rawio };
