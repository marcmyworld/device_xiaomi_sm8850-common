# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow gmscore_app vendor_dpmd:unix_stream_socket { connectto };
allow gmscore_app vendor_dpmtcm_socket:sock_file { write };
dontaudit gmscore_app vendor_hal_qspmhal_default:binder { call };
dontaudit gmscore_app vendor_hal_qspmhal_hwservice:hwservice_manager { find };
