# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_camera_client hal_aidlbgservice_service:service_manager { find };
allow hal_camera_client hal_camera_aon_service:service_manager { find };
allow hal_camera_client hal_dynamic_camera_service:service_manager { find };
allow hal_camera_client hal_postprocservice_service:service_manager { find };
allow hal_camera_client hal_quickcamera_service:service_manager { find };
allow hal_camera_client vendor_hal_camera_aon_hwservice:hwservice_manager { find };
allow hal_camera_client vendor_hal_camera_aon_service:service_manager { find };
allow hal_camera_client vendor_hal_camera_postproc_hwservice:hwservice_manager { find };
allow hal_camera_client vendor_hal_offlinecamera_service:service_manager { find };
