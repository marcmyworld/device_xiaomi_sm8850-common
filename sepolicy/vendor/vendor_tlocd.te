# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_tlocd firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_tlocd firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tlocd firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tlocd ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_tlocd self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_tlocd self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_tlocd tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_tlocd vendor_tlocd_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_tlocd vendor_tlocd_data_file:fifo_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_tlocd vendor_tlocd_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_tlocd vendor_tlocd_exec:file { read getattr map execute open entrypoint };
allowxperm vendor_tlocd self:qipcrtr_socket ioctl { 0xc300-0xc305 };
allowxperm vendor_tlocd self:socket ioctl { 0xc300-0xc305 };
