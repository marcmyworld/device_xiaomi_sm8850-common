# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_uniperf_client hal_uniperf_server:binder { call transfer };
allow hal_uniperf_client hal_uniperf_server:binder { transfer };
allow hal_uniperf_client hal_uniperf_server:fd { use };
allow hal_uniperf_client hal_uniperf_service:service_manager { find };
