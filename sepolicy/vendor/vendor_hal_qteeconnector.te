# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qteeconnector firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_qteeconnector firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_qteeconnector vendor_qteeconnector_opti_prop:file { read getattr map open };
allow vendor_hal_qteeconnector vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_qteeconnector vndservicemanager:binder { call transfer };
