# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

dontaudit fsck_untrusted sysfs:file { read };
dontaudit fsck_untrusted vendor_sysfs_usb_node:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
dontaudit fsck_untrusted vendor_sysfs_usb_node:file { ioctl read write getattr lock append map open watch watch_reads };
