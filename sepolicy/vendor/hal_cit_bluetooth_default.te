# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_cit_bluetooth_default, domain, hal_cit_bluetooth, hal_cit_bluetooth_server, halserverdomain;
type hal_cit_bluetooth_default_exec, exec_type, file_type, vendor_file_type;

allow hal_cit_bluetooth_default hal_cit_bluetooth_default_exec:file { read getattr map execute open entrypoint };
allow hal_cit_bluetooth_default hal_cit_bluetooth_default_exec:file { read getattr map execute open };
allow hal_cit_bluetooth_default hal_cit_bluetooth_service:service_manager { add };
allow hal_cit_bluetooth_default hal_cit_bluetooth_sub:process { siginh rlimitinh };
allow hal_cit_bluetooth_default hal_cit_bluetooth_sub:process { transition };
allow hal_cit_bluetooth_default servicemanager:binder { call transfer };
allow hal_cit_bluetooth_default vendor_shell_exec:file { read getattr map execute open };
dontaudit hal_cit_bluetooth_default hal_cit_bluetooth_sub:process { noatsecure };
type_transition hal_cit_bluetooth_default hal_cit_bluetooth_default_exec:process hal_cit_bluetooth_sub;
type_transition hal_cit_bluetooth_default vendor_shell_exec:process hal_cit_bluetooth_sub;
