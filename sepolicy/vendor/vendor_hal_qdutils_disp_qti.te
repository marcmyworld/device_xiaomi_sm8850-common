# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qdutils_disp_qti vendor_hal_qdutils_disp_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_qdutils_disp_qti vendor_qdisplay_service:service_manager { find };
allow vendor_hal_qdutils_disp_qti vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_qdutils_disp_qti vndservicemanager:binder { call transfer };
