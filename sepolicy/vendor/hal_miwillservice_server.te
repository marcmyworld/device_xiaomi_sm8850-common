# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_miwillservice_server hal_miwillservice_client:binder { call transfer };
allow hal_miwillservice_server hal_miwillservice_client:binder { transfer };
allow hal_miwillservice_server hal_miwillservice_client:fd { use };
allow hal_miwillservice_server hal_miwillservice_service:service_manager { add find };
allow hal_miwillservice_server servicemanager:binder { call transfer };
allow hal_miwillservice_server servicemanager:fd { use };
