# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_sensingdaemon self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_sensingdaemon self:unix_stream_socket { read write listen accept };
allow vendor_sensingdaemon vendor_sensing_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_sensingdaemon vendor_sensing_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_sensingdaemon vendor_sensingdaemon_exec:file { read getattr map execute open entrypoint };
