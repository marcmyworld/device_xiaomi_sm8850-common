# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_uwb dumpstate:binder { transfer };
allow hal_uwb init:unix_stream_socket { connectto };
allow hal_uwb property_socket:sock_file { write };
allow hal_uwb vendor_bt_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_uwb vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow hal_uwb vendor_q2spiuwb_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_uwb vendor_soc_id_prop:file { read getattr map open };
allow hal_uwb vendor_spiuwb_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_uwb vendor_ssgtzd:unix_stream_socket { connectto };
allow hal_uwb vendor_ssgtzd_socket:sock_file { write };
allow hal_uwb vendor_uwb_prop:file { read getattr map open };
allow hal_uwb vendor_uwb_prop:property_service { set };
