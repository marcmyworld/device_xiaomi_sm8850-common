# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mtdservice_server hal_mtdservice_client:binder { call transfer };
allow hal_mtdservice_server hal_mtdservice_client:binder { transfer };
allow hal_mtdservice_server hal_mtdservice_client:fd { use };
allow hal_mtdservice_server hal_mtdservice_service:service_manager { add find };
allow hal_mtdservice_server servicemanager:binder { call transfer };
allow hal_mtdservice_server servicemanager:fd { use };
