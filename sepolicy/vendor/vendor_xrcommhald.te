# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_xrcommhald servicemanager:binder { call transfer };
allow vendor_xrcommhald vendor_hal_xrcommservice_qti_socket_client:unix_stream_socket { read write };
allow vendor_xrcommhald vendor_xrcommd:unix_stream_socket { connectto };
allow vendor_xrcommhald vendor_xrcommd_socket:sock_file { write };
allow vendor_xrcommhald vendor_xrcommd_vndr_data_file:dir { write add_name search };
allow vendor_xrcommhald vendor_xrcommd_vndr_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_xrcommhald vendor_xrcommhald_exec:file { read getattr map execute open entrypoint };
