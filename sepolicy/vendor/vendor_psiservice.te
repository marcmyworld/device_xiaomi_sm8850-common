# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_psiservice boot_status_prop:file { read getattr map open };
allow vendor_psiservice proc_meminfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_psiservice proc_pressure_mem:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_psiservice proc_vmstat:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_psiservice proc_zoneinfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_psiservice self:cap_userns { sys_resource };
allow vendor_psiservice self:capability { sys_resource };
allow vendor_psiservice servicemanager:binder { call transfer };
allow vendor_psiservice servicemanager:fd { use };
allow vendor_psiservice sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_psiservice vendor_pasr_prop:file { read getattr map open };
allow vendor_psiservice vendor_psiservice_exec:file { read getattr map execute open entrypoint };
allow vendor_psiservice vendor_sysfs_mem_offline:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_psiservice vendor_sysfs_mem_offline:file { ioctl read write getattr lock append map open watch watch_reads };
