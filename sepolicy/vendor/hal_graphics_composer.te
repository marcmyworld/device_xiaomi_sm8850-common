# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_graphics_composer fwk_sensor_hwservice:hwservice_manager { find };
allow hal_graphics_composer fwk_sensor_service:service_manager { find };
allow hal_graphics_composer oemfs:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_graphics_composer self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_graphics_composer servicemanager:binder { call transfer };
allow hal_graphics_composer servicemanager:fd { use };
allow hal_graphics_composer system_server:binder { call transfer };
allow hal_graphics_composer system_server:binder { transfer };
allow hal_graphics_composer system_server:fd { use };
allow hal_graphics_composer vendor_display_notch_prop:file { read getattr map open };
allow hal_graphics_composer vendor_display_prop:file { read getattr map open };
allow hal_graphics_composer vendor_displayfeature_prop:file { read getattr map open };
allow hal_graphics_composer vendor_hal_citsensorservice_xiaomi_default:binder { transfer };
allow hal_graphics_composer vendor_hal_display_color:binder { transfer };
allow hal_graphics_composer vendor_hal_displayfeature_xiaomi:binder { transfer };
allow hal_graphics_composer vendor_hal_displayfeature_xiaomi_default:binder { transfer };
allow hal_graphics_composer vendor_sysfs_graphics:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_graphics_composer vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
