# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_mipowerservice_default, domain, hal_mipowerservice, hal_mipowerservice_server, halserverdomain, mlstrustedsubject;
type hal_mipowerservice_default_exec, exec_type, file_type, vendor_file_type;

allow hal_mipowerservice_default hal_mipowerhalservice_service:service_manager { add };
allow hal_mipowerservice_default hal_mipowerservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_mipowerservice_default mipower_hal:unix_stream_socket { connectto };
allow hal_mipowerservice_default power_hal_socket:sock_file { write };
allow hal_mipowerservice_default powerinsight_device:chr_file { ioctl read write open };
allow hal_mipowerservice_default qcom_stats_device:chr_file { ioctl read open };
allow hal_mipowerservice_default self:netlink_generic_socket { read write create getattr bind setopt };
allow hal_mipowerservice_default servicemanager:binder { call transfer };
allow hal_mipowerservice_default socket_device:dir { write create add_name remove_name };
allow hal_mipowerservice_default socket_device:sock_file { write create setattr unlink };
allow hal_mipowerservice_default sysfs:file { read open };
allow hal_mipowerservice_default sysfs:file { read write open };
allow hal_mipowerservice_default tmpfs:file { read write map };
allow hal_mipowerservice_default vendor_stability_prop:file { read getattr open };
allow hal_mipowerservice_default vendor_system_prop:file { read getattr map open };
allow hal_mipowerservice_default vendor_wlan_chip_prop:file { read getattr map open };
