# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_configstore_default hal_configstore_default_exec:file { read getattr map execute open entrypoint };
allow hal_configstore_default hal_graphics_composer_default:binder { call transfer };
allow hal_configstore_default hal_graphics_composer_default:fd { use };
allow hal_configstore_default vendor_hal_display_config_hwservice:hwservice_manager { find };
