# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_capabilityconfigstore_qti_default vendor_capabilityconfigstore_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_capabilityconfigstore_qti_default vendor_capabilityconfigstore_data_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_capabilityconfigstore_qti_default vendor_hal_capabilityconfigstore_qti_default_exec:file { read getattr map execute open entrypoint };
