# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_vehicle_default fwk_stats_hwservice:hwservice_manager { find };
allow hal_vehicle_default hal_vehicle_default_exec:file { read getattr map execute open entrypoint };
allow hal_vehicle_default hwservicemanager:binder { call transfer };
allow hal_vehicle_default stats_service_server:binder { call transfer };
allow hal_vehicle_default stats_service_server:fd { use };
