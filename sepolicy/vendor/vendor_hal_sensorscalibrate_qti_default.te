# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_sensorscalibrate_qti_default mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_sensorscalibrate_qti_default mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_sensorscalibrate_qti_default mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_sensorscalibrate_qti_default vendor_hal_sensorscalibrate_qti_default_exec:file { read getattr map execute open entrypoint };
