# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_fstman hal_wifi_hostapd_default:unix_dgram_socket { sendto };
allow vendor_fstman hal_wifi_supplicant:unix_dgram_socket { sendto };
allow vendor_fstman hostapd_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_fstman hostapd_data_file:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_fstman hwservicemanager:binder { call transfer };
allow vendor_fstman hwservicemanager_prop:file { read getattr map open };
allow vendor_fstman self:capability { net_admin net_raw };
allow vendor_fstman self:netlink_route_socket { nlmsg_write };
allow vendor_fstman sysfs_net:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_fstman system_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_fstman vendor_fstman_exec:file { read getattr map execute open entrypoint };
allow vendor_fstman vendor_sysfs_bond0:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_fstman vendor_sysfs_wigig:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_fstman vendor_wifi_vendor_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_fstman vendor_wifi_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_fstman vendor_wifi_vendor_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_fstman vendor_wifi_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_fstman vendor_wifi_vendor_data_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_fstman vendor_wifi_vendor_wpa_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_fstman vendor_wifi_vendor_wpa_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_fstman vendor_wigig_vendor_wpa_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
allowxperm vendor_fstman self:udp_socket ioctl { 0x8913-0x8914 0x8924 0x8943 0x8946 0x8990-0x8991 };
