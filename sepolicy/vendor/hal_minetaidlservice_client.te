# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_minetaidlservice_client hal_minetaidlservice_server:binder { call transfer };
allow hal_minetaidlservice_client hal_minetaidlservice_server:binder { transfer };
allow hal_minetaidlservice_client hal_minetaidlservice_server:fd { use };
allow hal_minetaidlservice_client hal_minetaidlservice_service:service_manager { find };
