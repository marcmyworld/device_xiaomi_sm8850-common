# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_display_demura_server servicemanager:binder { call transfer };
allow vendor_hal_display_demura_server servicemanager:fd { use };
allow vendor_hal_display_demura_server vendor_hal_display_demura_aidl_service:service_manager { add find };
allow vendor_hal_display_demura_server vendor_hal_display_demura_client:binder { call transfer };
allow vendor_hal_display_demura_server vendor_hal_display_demura_client:binder { transfer };
allow vendor_hal_display_demura_server vendor_hal_display_demura_client:fd { use };
