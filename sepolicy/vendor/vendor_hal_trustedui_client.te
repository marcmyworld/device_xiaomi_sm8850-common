# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_trustedui_client vendor_hal_trustedui_aidl_service:service_manager { find };
allow vendor_hal_trustedui_client vendor_hal_trustedui_hwservice:hwservice_manager { find };
allow vendor_hal_trustedui_client vendor_hal_trustedui_server:binder { call transfer };
allow vendor_hal_trustedui_client vendor_hal_trustedui_server:binder { transfer };
allow vendor_hal_trustedui_client vendor_hal_trustedui_server:fd { use };
