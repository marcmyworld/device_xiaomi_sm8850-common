# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_display_demura vendor_qdisplay_service:service_manager { find };
allow vendor_hal_display_demura vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_display_demura vndservicemanager:binder { call transfer };
