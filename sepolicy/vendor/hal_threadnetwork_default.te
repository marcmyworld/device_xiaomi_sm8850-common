# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_threadnetwork_default devpts:chr_file { ioctl read write open };
allow hal_threadnetwork_default hal_threadnetwork_default_exec:file { read getattr map execute open entrypoint };
allow hal_threadnetwork_default ot_rcp:process { siginh rlimitinh };
allow hal_threadnetwork_default ot_rcp:process { signal };
allow hal_threadnetwork_default ot_rcp:process { transition };
allow hal_threadnetwork_default ot_rcp_exec:file { read getattr map execute open };
dontaudit hal_threadnetwork_default ot_rcp:process { noatsecure };
