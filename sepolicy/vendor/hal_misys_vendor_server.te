# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_misys_vendor_server cameraserver:binder { transfer };
allow hal_misys_vendor_server dumpstate:fd { use };
allow hal_misys_vendor_server dumpstate:fifo_file { write };
allow hal_misys_vendor_server hal_misys_vendor_client:binder { call transfer };
allow hal_misys_vendor_server hal_misys_vendor_client:binder { transfer };
allow hal_misys_vendor_server hal_misys_vendor_client:fd { use };
allow hal_misys_vendor_server hal_misys_vendor_service:service_manager { add find };
allow hal_misys_vendor_server servicemanager:binder { call transfer };
allow hal_misys_vendor_server servicemanager:fd { use };
