# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_cstransfer hal_audio_default:binder { call transfer };
allow hal_cstransfer hal_audio_default:binder { transfer };
allow hal_cstransfer hal_audio_default:fd { use };
allow hal_cstransfer mediaserver:binder { transfer };
allow hal_cstransfer servicemanager:binder { call transfer };
allow hal_cstransfer servicemanager:fd { use };
allow hal_cstransfer system_app:binder { call transfer };
allow hal_cstransfer system_app:binder { transfer };
allow hal_cstransfer system_app:fd { use };
