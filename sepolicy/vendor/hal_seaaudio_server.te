# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_seaaudio_server dumpstate:fd { use };
allow hal_seaaudio_server dumpstate:fifo_file { write };
allow hal_seaaudio_server hal_seaaudio_client:binder { call transfer };
allow hal_seaaudio_server hal_seaaudio_client:binder { transfer };
allow hal_seaaudio_server hal_seaaudio_client:fd { use };
allow hal_seaaudio_server hal_seaaudio_service:service_manager { add find };
allow hal_seaaudio_server servicemanager:binder { call transfer };
allow hal_seaaudio_server servicemanager:fd { use };
