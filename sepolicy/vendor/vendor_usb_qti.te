# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_usb_qti vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_usb_qti vendor_ssgtzd:unix_stream_socket { connectto };
allow vendor_usb_qti vendor_ssgtzd_socket:sock_file { write };
allow vendor_usb_qti vendor_sysfs_usb_device:file { write lock append map open };
allow vendor_usb_qti vendor_usb_qti_exec:file { read getattr map execute open entrypoint };
