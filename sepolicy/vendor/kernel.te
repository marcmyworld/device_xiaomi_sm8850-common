# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow kernel block_device:dir { getattr search };
allow kernel firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow kernel firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow kernel firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow kernel sepolicy_file:file { getattr };
allow kernel system_bootstrap_lib_file:dir { getattr };
allow kernel system_bootstrap_lib_file:file { getattr };
allow kernel system_dlkm_file:dir { getattr };
allow kernel vendor_firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow kernel vendor_firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow kernel vendor_firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow kernel vendor_hal_usb_qti:fd { use };
allow kernel vendor_ramdump_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow kernel vendor_vm_mgr:fd { use };
allow kernel vendor_vm_system_file:file { ioctl read getattr lock map open watch watch_reads };
dontaudit kernel kernel:system { module_request };
