# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_videoservice_server hal_videoservice_client:binder { call transfer };
allow hal_videoservice_server hal_videoservice_client:binder { transfer };
allow hal_videoservice_server hal_videoservice_client:fd { use };
allow hal_videoservice_server hal_videoservice_service:service_manager { add find };
