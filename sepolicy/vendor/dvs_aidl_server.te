# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow dvs_aidl_server dvs_aidl_client:binder { call transfer };
allow dvs_aidl_server dvs_aidl_client:binder { transfer };
allow dvs_aidl_server dvs_aidl_client:fd { use };
allow dvs_aidl_server init:unix_stream_socket { connectto };
allow dvs_aidl_server property_socket:sock_file { write };
allow dvs_aidl_server vendor_dolbyv_prop:file { read getattr map open };
allow dvs_aidl_server vendor_dolbyv_prop:property_service { set };
