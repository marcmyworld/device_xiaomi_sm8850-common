# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_bluetooth_default bt_device:chr_file { ioctl read write open };
allow hal_bluetooth_default bt_firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bluetooth_default bt_firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth_default bt_firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth_default debugfs_tracing_instances:dir { search };
allow hal_bluetooth_default dumpstate:binder { transfer };
allow hal_bluetooth_default hal_bluetooth_default_exec:file { read getattr map execute open entrypoint };
allow hal_bluetooth_default mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bluetooth_default mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth_default mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth_default proc_sysrq:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth_default self:bluetooth_socket { read write create bind };
allow hal_bluetooth_default self:netlink_generic_socket { read write create getattr bind setopt };
allow hal_bluetooth_default self:netlink_route_socket { nlmsg_read nlmsg_write };
allow hal_bluetooth_default self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_bluetooth_default self:socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_bluetooth_default self:udp_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_bluetooth_default vendor_bsp_data_log_file:dir { read write create setattr open add_name search };
allow hal_bluetooth_default vendor_bsp_data_log_file:file { read write create setattr open };
allow hal_bluetooth_default vendor_bt_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_bluetooth_default vendor_bt_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name search };
allow hal_bluetooth_default vendor_bt_data_file:dir { search };
allow hal_bluetooth_default vendor_bt_data_file:dir { write add_name search };
allow hal_bluetooth_default vendor_bt_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_bluetooth_default vendor_bt_data_file:file { read write create getattr append open };
allow hal_bluetooth_default vendor_bt_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth_default vendor_data_file:dir { write add_name };
allow hal_bluetooth_default vendor_data_file:file { read write create getattr append open };
userdebug_or_eng(`
    allow hal_bluetooth_default vendor_debugfs_bt_tracing:dir { ioctl read getattr lock open watch watch_reads search };
    allow hal_bluetooth_default vendor_debugfs_bt_tracing:file { ioctl read getattr lock map open watch watch_reads };
')
allow hal_bluetooth_default vendor_diag_device:chr_file { ioctl getattr };
allow hal_bluetooth_default vendor_diag_device:chr_file { read write open };
allow hal_bluetooth_default vendor_fm_radio_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth_default vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow hal_bluetooth_default vendor_mac_vendor_data_file:dir { search };
allow hal_bluetooth_default vendor_mac_vendor_data_file:file { read open };
allow hal_bluetooth_default vendor_persist_bluetooth_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_bluetooth_default vendor_persist_bluetooth_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_bluetooth_default vendor_ramdump_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_bluetooth_default vendor_ramdump_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_bluetooth_default vendor_soc_id_prop:file { read getattr map open };
allow hal_bluetooth_default vendor_ssgtzd:unix_stream_socket { connectto };
allow hal_bluetooth_default vendor_ssgtzd_socket:sock_file { write };
allow hal_bluetooth_default vendor_wifi_vendor_data_file:dir { search };
allow hal_bluetooth_default vendor_wifi_vendor_data_file:file { read open };
allow hal_bluetooth_default wdsdaemon:binder { call };
allowxperm hal_bluetooth_default self:udp_socket ioctl { 0x8914 };
