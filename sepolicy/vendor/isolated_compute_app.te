# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow isolated_compute_app vendor_sysfs_public:dir { ioctl read getattr lock open watch watch_reads search };
allow isolated_compute_app vendor_sysfs_public:file { ioctl read getattr lock map open watch watch_reads };
allow isolated_compute_app vendor_sysfs_public:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow isolated_compute_app vendor_sysfs_soc:dir { search };
