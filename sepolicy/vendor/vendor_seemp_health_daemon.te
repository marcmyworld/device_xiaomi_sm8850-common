# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_seemp_health_daemon tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_seemp_health_daemon vendor_seemp_health_daemon_exec:file { read getattr map execute open entrypoint };
