# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow ppp mtp:pppox_socket { ioctl read write getattr setattr lock append map bind connect getopt setopt shutdown };
allowxperm ppp mtp:pppox_socket ioctl { 0x7436-0x7441 0x7446-0x7447 0x744b-0x745a 0x7480-0x7488 };
