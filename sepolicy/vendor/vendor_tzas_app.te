# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_tzas_app app_api_service:service_manager { find };
allow vendor_tzas_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_tzas_app vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_tzas_app vendor_ssgtzd:unix_stream_socket { connectto };
allow vendor_tzas_app vendor_ssgtzd_socket:sock_file { write };
allow vendor_tzas_app vendor_tzas_app_userfaultfd:anon_inode { ioctl read create };
allowxperm vendor_tzas_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
