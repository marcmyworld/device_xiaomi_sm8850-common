# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_touchfeature_xiaomi_server hal_touchfeature_xiaomi_client:binder { transfer };
allow hal_touchfeature_xiaomi_server hal_touchfeature_xiaomi_service:service_manager { add find };
allow hal_touchfeature_xiaomi_server servicemanager:binder { call transfer };
