# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_tetheroffload self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_tetheroffload self:netlink_route_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown nlmsg_read nlmsg_readpriv };
allow hal_tetheroffload self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_tetheroffload self:udp_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_tetheroffload vendor_ipa_dev:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_tetheroffload vendor_ipa_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_tetheroffload vendor_ipa_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
