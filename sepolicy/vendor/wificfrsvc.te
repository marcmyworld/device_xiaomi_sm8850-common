# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow wificfrsvc servicemanager:binder { call transfer };
allow wificfrsvc servicemanager:fd { use };
allow wificfrsvc vendor_wifi_cfr_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow wificfrsvc vendor_wifi_cfr_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow wificfrsvc vendor_wifi_vendor_data_file:dir { search };
allow wificfrsvc wificfrsvc_exec:file { read getattr map execute open entrypoint };
