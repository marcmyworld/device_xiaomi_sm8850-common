# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_mem_pasrmanager_server servicemanager:binder { call transfer };
allow vendor_hal_mem_pasrmanager_server servicemanager:fd { use };
allow vendor_hal_mem_pasrmanager_server vendor_aidl_hal_pasrmanager_memory_service:service_manager { add find };
allow vendor_hal_mem_pasrmanager_server vendor_hal_mem_pasrmanager_client:binder { transfer };
