# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_modem_manager anr_data_file:file { append };
allow vendor_modem_manager dumpstate:fd { use };
allow vendor_modem_manager dumpstate:fifo_file { write append };
allow vendor_modem_manager incidentd:fd { use };
allow vendor_modem_manager incidentd:fifo_file { write append };
allow vendor_modem_manager system_server:fifo_file { write append };
allow vendor_modem_manager tombstone_data_file:file { append };
allow vendor_modem_manager tombstoned:fd { use };
allow vendor_modem_manager tombstoned:unix_stream_socket { connectto };
allow vendor_modem_manager tombstoned_crash_socket:sock_file { write };
allow vendor_modem_manager vendor_cnd_vendor_prop:file { read getattr map open };
allow vendor_modem_manager vendor_hal_qesdhal:unix_stream_socket { connectto };
allow vendor_modem_manager vendor_modem_manager_exec:file { read getattr map execute open entrypoint };
allow vendor_modem_manager vendor_qesd_socket:sock_file { write };
