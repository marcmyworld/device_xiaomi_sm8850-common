# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_mpamsvc_qesdk servicemanager:binder { call transfer };
allow vendor_mpamsvc_qesdk vendor_hal_qesdhal:unix_stream_socket { connectto };
allow vendor_mpamsvc_qesdk vendor_mpam_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_mpamsvc_qesdk vendor_mpam_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_mpamsvc_qesdk vendor_mpamsvc_qesdk_exec:file { read getattr map execute open entrypoint };
allow vendor_mpamsvc_qesdk vendor_qesd_socket:sock_file { write };
allow vendor_mpamsvc_qesdk vendor_qsap_mpamsvc_service:service_manager { add find };
allow vendor_mpamsvc_qesdk vendor_sysfs_mpam:dir { search };
allow vendor_mpamsvc_qesdk vendor_sysfs_mpam:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mpamsvc_qesdk vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mpamsvc_qesdk vndservicemanager:binder { call transfer };
