# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mseccam_server dumpstate:fd { use };
allow hal_mseccam_server dumpstate:fifo_file { write };
allow hal_mseccam_server hal_mseccam_client:binder { call transfer };
allow hal_mseccam_server hal_mseccam_client:binder { transfer };
allow hal_mseccam_server hal_mseccam_client:fd { use };
allow hal_mseccam_server hal_mseccam_service:service_manager { add find };
allow hal_mseccam_server servicemanager:binder { call transfer };
allow hal_mseccam_server servicemanager:fd { use };
