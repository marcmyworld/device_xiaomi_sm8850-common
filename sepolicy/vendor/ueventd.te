# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow ueventd firmware_file:dir { search };
allow ueventd firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow ueventd mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow ueventd mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow ueventd mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow ueventd mnt_vendor_vm_file:dir { ioctl read getattr lock open watch watch_reads search };
allow ueventd mnt_vendor_vm_file:file { ioctl read getattr lock map open watch watch_reads };
allow ueventd tmpfs:blk_file { getattr };
allow ueventd vendor_persist_file:dir { search };
allow ueventd vendor_persist_file:file { ioctl read getattr lock map open watch watch_reads };
allow ueventd vendor_sysfs_bond0:file { ioctl read write getattr lock append map open watch watch_reads };
allow ueventd vendor_sysfs_xm_power:chr_file { create };
allow ueventd vendor_sysfs_xm_power:chr_file { setattr };
allow ueventd vendor_sysfs_xm_power:dir { search };
allow ueventd vendor_sysfs_xm_power:file { ioctl read write getattr lock append map open watch watch_reads };
allow ueventd vendor_sysfs_xm_power:file { read write open };
allow ueventd vendor_vm_file:dir { ioctl read getattr lock open watch watch_reads search };
allow ueventd vendor_vm_file:file { ioctl read getattr lock map open watch watch_reads };
allow ueventd vendor_vm_mgr:process { siginh rlimitinh };
allow ueventd vendor_vm_mgr:process { transition };
allow ueventd vendor_vm_mgr_exec:file { read getattr map execute open };
allow ueventd vendor_vm_system_file:dir { read getattr search };
allow ueventd vendor_vm_system_file:file { ioctl read getattr lock map open watch watch_reads };
dontaudit ueventd vendor_vm_mgr:process { noatsecure };
