# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow installd sysfs_devices_block:dir { search };
allow installd sysfs_devices_block:file { read getattr open };
allow installd sysfs_memory:dir { search };
allow installd sysfs_memory:file { read getattr open };
allow installd sysfs_memory:file { read open };
