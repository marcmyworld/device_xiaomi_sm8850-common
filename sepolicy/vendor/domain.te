# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow domain vendor_gralloc_prop:file { read getattr map open };
allow domain vendor_public_vendor_default_prop:file { read getattr map open };
allow domain vendor_security_patch_level_prop:file { read getattr map open };
dontaudit domain kernel:system { module_request };
dontaudit domain vendor_hal_perf2_service:service_manager { find };
dontaudit domain vendor_hal_perf_hwservice:hwservice_manager { find };
dontaudit domain vendor_hal_qspmhal_service:service_manager { find };
dontaudit domain vendor_persist_dpm_prop:file { ioctl read getattr lock map open watch watch_reads };
