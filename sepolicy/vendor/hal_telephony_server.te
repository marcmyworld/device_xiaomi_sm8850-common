# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_telephony_server init:unix_stream_socket { connectto };
allow hal_telephony_server property_socket:sock_file { write };
allow hal_telephony_server servicemanager:binder { call transfer };
allow hal_telephony_server servicemanager:fd { use };
allow hal_telephony_server vendor_hal_telephony_service2:service_manager { add find };
allow hal_telephony_server vendor_hal_telephony_service:service_manager { add find };
allow hal_telephony_server vendor_radio_prop:file { read getattr map open };
allow hal_telephony_server vendor_radio_prop:property_service { set };
