# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_fm_app vendor_bluetooth_prop:file { read getattr map open };
allow vendor_fm_app vendor_sysfs_kgsl:file { ioctl read getattr lock map open watch watch_reads };
