# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hlosminkdaemon hal_camera_default:fd { use };
allow vendor_hlosminkdaemon hal_graphics_allocator_default:fd { use };
allow vendor_hlosminkdaemon self:capability2 { wake_alarm block_suspend };
allow vendor_hlosminkdaemon self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hlosminkdaemon self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hlosminkdaemon sysfs_wake_lock:file { append open };
allow vendor_hlosminkdaemon tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hlosminkdaemon vendor_firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_hal_c2pa_qti:fd { use };
allow vendor_hlosminkdaemon vendor_hal_secureprocessor_qti:fd { use };
allow vendor_hlosminkdaemon vendor_hal_trustedui_qti:fd { use };
allow vendor_hlosminkdaemon vendor_hlosminkdaemon_exec:file { read getattr map execute open entrypoint };
allow vendor_hlosminkdaemon vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_qwes_data_file:dir { getattr setattr };
allow vendor_hlosminkdaemon vendor_vm_oem_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_vm_self_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vendor_vm_trusted_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hlosminkdaemon vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hlosminkdaemon vndservicemanager:binder { call transfer };
allowxperm vendor_hlosminkdaemon self:qipcrtr_socket ioctl { 0xc300-0xc305 };
allowxperm vendor_hlosminkdaemon self:socket ioctl { 0xc300-0xc305 };
