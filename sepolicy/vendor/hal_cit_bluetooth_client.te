# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_cit_bluetooth_client hal_cit_bluetooth_server:binder { call transfer };
allow hal_cit_bluetooth_client hal_cit_bluetooth_server:binder { transfer };
allow hal_cit_bluetooth_client hal_cit_bluetooth_server:fd { use };
allow hal_cit_bluetooth_client hal_cit_bluetooth_service:service_manager { find };
