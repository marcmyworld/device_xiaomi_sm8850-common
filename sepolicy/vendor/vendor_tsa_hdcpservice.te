# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_tsa_hdcpservice firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_tsa_hdcpservice firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice servicemanager:binder { call transfer };
allow vendor_tsa_hdcpservice tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_qce_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_tsa_hdcpservice_exec:file { read getattr map execute open entrypoint };
allow vendor_tsa_hdcpservice vendor_tsa_hdcpvndservice:service_manager { add find };
allow vendor_tsa_hdcpservice vendor_vm_cp_bitstream_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_tsa_hdcpservice vendor_wfdvndservice:binder { call transfer };
allow vendor_tsa_hdcpservice vendor_wfdvndservice:binder { transfer };
allow vendor_tsa_hdcpservice vendor_wfdvndservice:fd { use };
allow vendor_tsa_hdcpservice vendor_wifidisplayhalservice_qti:binder { call transfer };
allow vendor_tsa_hdcpservice vendor_wifidisplayhalservice_qti:binder { transfer };
allow vendor_tsa_hdcpservice vendor_wifidisplayhalservice_qti:fd { use };
allow vendor_tsa_hdcpservice vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_tsa_hdcpservice vndservicemanager:binder { call transfer };
