# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_can_socketcan hal_can_socketcan_exec:file { read getattr map execute open entrypoint };
allow hal_can_socketcan hidl_manager_hwservice:hwservice_manager { find };
allow hal_can_socketcan self:can_socket { ioctl read write create bind setopt };
allow hal_can_socketcan self:capability { net_admin };
allow hal_can_socketcan self:netlink_route_socket { read write create bind nlmsg_write };
allow hal_can_socketcan self:udp_socket { ioctl create };
allow hal_can_socketcan sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_can_socketcan usb_serial_device:chr_file { ioctl read write open };
allowxperm hal_can_socketcan self:can_socket ioctl { 0x8913-0x8914 };
allowxperm hal_can_socketcan self:udp_socket ioctl { 0x8913-0x8914 0x8933 };
allowxperm hal_can_socketcan usb_serial_device:chr_file ioctl { 0x5401 0x5403 0x541e-0x541f 0x5423 };
allowxperm hal_can_socketcan usb_serial_device:chr_file ioctl { 0x8910 };
