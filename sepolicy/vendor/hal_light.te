# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_light vendor_sysfs_graphics:dir { search };
allow hal_light vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
