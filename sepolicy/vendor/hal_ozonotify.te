# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_ozonotify hal_audio_default:binder { call transfer };
allow hal_ozonotify hal_audio_default:binder { transfer };
allow hal_ozonotify hal_audio_default:fd { use };
allow hal_ozonotify mediaserver:binder { transfer };
allow hal_ozonotify platform_app_all:binder { call transfer };
allow hal_ozonotify platform_app_all:binder { transfer };
allow hal_ozonotify platform_app_all:fd { use };
allow hal_ozonotify servicemanager:binder { call transfer };
allow hal_ozonotify servicemanager:fd { use };
allow hal_ozonotify untrusted_app:binder { call transfer };
allow hal_ozonotify untrusted_app:binder { transfer };
allow hal_ozonotify untrusted_app:fd { use };
allow hal_ozonotify untrusted_app_30:binder { call transfer };
allow hal_ozonotify untrusted_app_30:binder { transfer };
allow hal_ozonotify untrusted_app_30:fd { use };
allow hal_ozonotify untrusted_app_32:binder { call transfer };
allow hal_ozonotify untrusted_app_32:binder { transfer };
allow hal_ozonotify untrusted_app_32:fd { use };
allow hal_ozonotify untrusted_app_all:binder { call transfer };
allow hal_ozonotify untrusted_app_all:binder { transfer };
allow hal_ozonotify untrusted_app_all:fd { use };
