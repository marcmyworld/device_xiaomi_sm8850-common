# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow update_engine_common adsprpcd_file:dir { search };
allow update_engine_common bt_firmware_file:filesystem { getattr };
allow update_engine_common firmware_file:dir { search };
allow update_engine_common firmware_file:filesystem { getattr };
allow update_engine_common metadata_file:dir { search };
allow update_engine_common recovery_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine_common tmpfs:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow update_engine_common vendor_custom_ab_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine_common vendor_modem_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine_common vendor_ssd_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine_common vendor_uefi_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow update_engine_common vendor_xbl_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
dontaudit update_engine_common self:capability { dac_override dac_read_search };
