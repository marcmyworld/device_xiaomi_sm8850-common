# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_gatekeeper_remote device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_gatekeeper_remote gatekeeper_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_gatekeeper_remote hal_gatekeeper_remote_exec:file { read getattr map execute open entrypoint };
allow hal_gatekeeper_remote kmsg_device:chr_file { getattr };
allow hal_gatekeeper_remote kmsg_device:chr_file { write lock append map open };
