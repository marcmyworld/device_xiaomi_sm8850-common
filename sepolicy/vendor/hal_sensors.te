# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_sensors vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors vendor_sysfs_sensors:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_sensors vendor_sysfs_sensors:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_sensors vendor_sysfs_sensors:lnk_file { read };
