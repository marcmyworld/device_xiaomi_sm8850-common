# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_init-qcom-crashdata-sh init:unix_stream_socket { connectto };
allow vendor_init-qcom-crashdata-sh property_socket:sock_file { write };
allow vendor_init-qcom-crashdata-sh vendor_crash_cnt_prop:file { read getattr map open };
allow vendor_init-qcom-crashdata-sh vendor_crash_cnt_prop:property_service { set };
allow vendor_init-qcom-crashdata-sh vendor_crash_detect_prop:file { read getattr map open };
allow vendor_init-qcom-crashdata-sh vendor_crash_detect_prop:property_service { set };
allow vendor_init-qcom-crashdata-sh vendor_init-qcom-crashdata-sh_exec:file { read getattr map execute open entrypoint };
allow vendor_init-qcom-crashdata-sh vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_init-qcom-crashdata-sh vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
