# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow bootanim audioserver:binder { transfer };
allow bootanim hwservicemanager:binder { call };
allow bootanim perf_actuator_device:chr_file { ioctl read write open };
allow bootanim vendor_audio_prop:file { read };
allow bootanim vendor_display_prop:file { read getattr map open };
allow bootanim vendor_proc_audiod:file { read };
allow bootanim xr_fbt_device:chr_file { ioctl read write open };
allowxperm bootanim perf_actuator_device:chr_file ioctl { 0x7807 0x780b 0x781b };
allowxperm bootanim xr_fbt_device:chr_file ioctl { 0x7807 0x780b 0x781b };
dontaudit bootanim system_data_file:dir { read };
dontaudit bootanim vendor_hal_qspmhal_hwservice:hwservice_manager { find };
dontaudit bootanim vendor_hal_qspmhal_service:service_manager { find };
