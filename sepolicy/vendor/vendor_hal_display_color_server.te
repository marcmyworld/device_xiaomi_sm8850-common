# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_display_color_server platform_app:binder { transfer };
allow vendor_hal_display_color_server servicemanager:binder { call transfer };
allow vendor_hal_display_color_server servicemanager:fd { use };
allow vendor_hal_display_color_server vendor_hal_display_color_aidl_service:service_manager { add find };
allow vendor_hal_display_color_server vendor_hal_display_color_client:binder { transfer };
