# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qconfigservice servicemanager:binder { call transfer };
allow vendor_qconfigservice servicemanager:fd { use };
allow vendor_qconfigservice vendor_qconfigservice_exec:file { read getattr map execute open entrypoint };
