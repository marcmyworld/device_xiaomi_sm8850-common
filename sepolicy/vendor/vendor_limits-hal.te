# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_limits-hal self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_limits-hal sysfs_thermal:file { write lock append map open };
allow vendor_limits-hal vendor_limits-hal_exec:file { read getattr map execute open entrypoint };
