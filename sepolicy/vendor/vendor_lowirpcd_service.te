# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_lowirpcd_service dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_lowirpcd_service hal_system_suspend_service:service_manager { find };
allow vendor_lowirpcd_service hidl_manager_hwservice:hwservice_manager { find };
allow vendor_lowirpcd_service hwservicemanager:binder { call transfer };
allow vendor_lowirpcd_service hwservicemanager_prop:file { read getattr map open };
allow vendor_lowirpcd_service ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_lowirpcd_service self:cap2_userns { block_suspend };
allow vendor_lowirpcd_service self:capability2 { block_suspend };
allow vendor_lowirpcd_service servicemanager:binder { call transfer };
allow vendor_lowirpcd_service sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_lowirpcd_service system_suspend_hwservice:hwservice_manager { find };
allow vendor_lowirpcd_service system_suspend_server:binder { call transfer };
allow vendor_lowirpcd_service system_suspend_server:fd { use };
allow vendor_lowirpcd_service vendor_adsprpc_prop:file { read getattr map open };
allow vendor_lowirpcd_service vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_lowirpcd_service vendor_lowirpcd_service_exec:file { read getattr map execute open entrypoint };
allow vendor_lowirpcd_service vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };
