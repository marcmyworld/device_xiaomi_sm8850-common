# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_dumpstate_default dumpstate:binder { transfer };
allow hal_dumpstate_default hal_dumpstate_default_exec:file { read getattr map execute open entrypoint };
allow hal_dumpstate_default servicemanager:binder { call transfer };
