# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_server:binder { call transfer };
allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_server:binder { transfer };
allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_server:fd { use };
allow hal_mediaeventgatherservice_client hal_mediaeventgatherservice_service:service_manager { find };
