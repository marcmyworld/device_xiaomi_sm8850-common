# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_hwcrypto_server hal_hwcrypto_client:binder { transfer };
allow hal_hwcrypto_server hal_hwcrypto_service:service_manager { add find };
allow hal_hwcrypto_server servicemanager:binder { call transfer };
