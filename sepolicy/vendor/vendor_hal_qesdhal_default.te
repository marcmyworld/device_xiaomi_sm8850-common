# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qesdhal_default anr_data_file:file { append };
allow vendor_hal_qesdhal_default boot_status_prop:file { read getattr map open };
allow vendor_hal_qesdhal_default dumpstate:fd { use };
allow vendor_hal_qesdhal_default dumpstate:fifo_file { write append };
allow vendor_hal_qesdhal_default incidentd:fd { use };
allow vendor_hal_qesdhal_default incidentd:fifo_file { write append };
allow vendor_hal_qesdhal_default init:unix_stream_socket { connectto };
allow vendor_hal_qesdhal_default property_socket:sock_file { write };
allow vendor_hal_qesdhal_default servicemanager:binder { call transfer };
allow vendor_hal_qesdhal_default system_server:fifo_file { write append };
allow vendor_hal_qesdhal_default tombstone_data_file:file { append };
allow vendor_hal_qesdhal_default tombstoned:fd { use };
allow vendor_hal_qesdhal_default tombstoned:unix_stream_socket { connectto };
allow vendor_hal_qesdhal_default tombstoned_crash_socket:sock_file { write };
allow vendor_hal_qesdhal_default vendor_hal_qesdhal_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_qesdhal_default vendor_qesd_socket:sock_file { write lock append map open };
allow vendor_hal_qesdhal_default vendor_qesdk_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_qesdhal_default vendor_qesdk_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_qesdhal_default vendor_qesdk_mgr_prop:file { read getattr map open };
allow vendor_hal_qesdhal_default vendor_qesdk_mgr_prop:property_service { set };
allow vendor_hal_qesdhal_default vendor_qesdk_ready_prop:file { read getattr map open };
allow vendor_hal_qesdhal_default vendor_qesdk_ready_prop:property_service { set };
allow vendor_hal_qesdhal_default vendor_qesdk_service:service_manager { find };
allow vendor_hal_qesdhal_default vendor_qesdoem_default:unix_stream_socket { connectto };
allow vendor_hal_qesdhal_default vendor_qesdoem_socket:sock_file { write };
allow vendor_hal_qesdhal_default vendor_qesdsec_socket:sock_file { write };
allow vendor_hal_qesdhal_default vendor_qesdsect:dir { search };
allow vendor_hal_qesdhal_default vendor_qesdsect:file { read };
allow vendor_hal_qesdhal_default vendor_qesdsect:lnk_file { read };
allow vendor_hal_qesdhal_default vendor_qesdsect:unix_stream_socket { connectto };
