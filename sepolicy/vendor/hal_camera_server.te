# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_camera_server hal_aidlbgservice_service:service_manager { add find };
allow hal_camera_server hal_camera_aon_service:service_manager { add find };
allow hal_camera_server hal_dynamic_camera_service:service_manager { add find };
allow hal_camera_server hal_mivimessage_service:service_manager { add find };
allow hal_camera_server hal_postprocservice_service:service_manager { add find };
allow hal_camera_server hal_quickcamera_service:service_manager { add find };
allow hal_camera_server hidl_base_hwservice:hwservice_manager { add };
allow hal_camera_server vendor_hal_camera_aon_hwservice:hwservice_manager { add find };
allow hal_camera_server vendor_hal_camera_aon_service:service_manager { add find };
allow hal_camera_server vendor_hal_camera_postproc_hwservice:hwservice_manager { add find };
allow hal_camera_server vendor_hal_offlinecamera_service:service_manager { add find };
