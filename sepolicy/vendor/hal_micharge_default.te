# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_micharge_default, domain, hal_micharge, hal_micharge_client, hal_micharge_server, halclientdomain, halserverdomain;
type hal_micharge_default_exec, exec_type, file_type, vendor_file_type;

allow hal_micharge_default dmabuf_system_heap_device:chr_file { ioctl read open };
allow hal_micharge_default hal_micharge_default_exec:file { read getattr map execute open entrypoint };
allow hal_micharge_default hidraw_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default servicemanager:binder { call transfer };
allow hal_micharge_default sysfs:dir { read getattr open search };
allow hal_micharge_default sysfs:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default vendor_sysfs_battery_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_qcom_battery:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default vendor_sysfs_qcom_battery:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_qcom_battery:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_qcom_battery:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_node:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default vendor_sysfs_usb_node:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_node:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_node:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default vendor_sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_xm_power:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default vendor_sysfs_xm_power:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default vendor_sysfs_xm_power:file { read write open };
dontaudit hal_micharge_default default_prop:file { read getattr map open };
