# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow appdomain vendor_adsprpc_prop:file { read getattr map open };
allow appdomain vendor_camera_prop:file { read getattr map open };
allow appdomain vendor_display_prop:file { read getattr map open };
allow appdomain vendor_dynamiccamera_config_prop:file { read getattr map open };
allow appdomain vendor_iop_prop:file { read getattr map open };
allow appdomain vendor_npu_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow appdomain vendor_qdsp_device:chr_file { ioctl read };
allow appdomain vendor_video_mi_prop:file { read getattr map open };
allow appdomain zygote:unix_dgram_socket { getopt };
dontaudit appdomain vendor_hal_qspmhal_hwservice:hwservice_manager { find };
