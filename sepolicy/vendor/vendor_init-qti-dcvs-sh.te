# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_init-qti-dcvs-sh self:perf_event { open cpu };
allow vendor_init-qti-dcvs-sh sysfs:dir { read open };
allow vendor_init-qti-dcvs-sh vendor_init-qti-dcvs-sh_exec:file { read getattr map execute open entrypoint };
allow vendor_init-qti-dcvs-sh vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_init-qti-dcvs-sh vendor_sysfs_devfreq:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_init-qti-dcvs-sh vendor_sysfs_devfreq:file { write lock append map open };
