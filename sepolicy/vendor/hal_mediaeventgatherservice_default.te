# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_mediaeventgatherservice_default, domain, hal_mediaeventgatherservice, hal_mediaeventgatherservice_server, halserverdomain;
type hal_mediaeventgatherservice_default_exec, exec_type, file_type, vendor_file_type;

allow hal_mediaeventgatherservice_default hal_mediaeventgatherservice:binder { call };
allow hal_mediaeventgatherservice_default hal_mediaeventgatherservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_mediaeventgatherservice_default hal_mediaeventgatherservice_service:service_manager { add find };
allow hal_mediaeventgatherservice_default hal_system_suspend_service:service_manager { find };
allow hal_mediaeventgatherservice_default servicemanager:binder { call transfer };
