# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow shell mi_ic_data_file:dir { getattr };
allow shell vendor_fp_info_prop:file { read getattr map open };
allow shell vendor_fp_prop:file { read getattr map open };
allow shell vendor_miface_prop:file { read getattr map open };
allow shell vendor_payment_security_prop:file { read getattr map open };
allow shell vendor_sysfs_kgsl_shell:file { ioctl read write getattr lock append map open watch watch_reads };
allow shell vendor_touchfeature_prop:file { read getattr map open };
