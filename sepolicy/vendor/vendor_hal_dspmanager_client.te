# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_dspmanager_client vendor_hal_dspmanager_aidlservice:service_manager { find };
allow vendor_hal_dspmanager_client vendor_hal_dspmanager_server:binder { call transfer };
allow vendor_hal_dspmanager_client vendor_hal_dspmanager_server:binder { transfer };
allow vendor_hal_dspmanager_client vendor_hal_dspmanager_server:fd { use };
