# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qmuxd init:unix_stream_socket { connectto };
allow vendor_qmuxd property_socket:sock_file { write };
allow vendor_qmuxd vendor_ctl_qmuxd_prop:file { read getattr map open };
allow vendor_qmuxd vendor_ctl_qmuxd_prop:property_service { set };
allow vendor_qmuxd vendor_qmuxd_exec:file { read getattr map execute open entrypoint };
