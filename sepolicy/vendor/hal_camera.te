# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_camera adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_camera adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_camera adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_camera fwk_sensor_hwservice:hwservice_manager { find };
allow hal_camera gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_camera init:unix_stream_socket { connectto };
allow hal_camera property_socket:sock_file { write };
allow hal_camera self:capability { sys_nice };
allow hal_camera self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_camera system_server:binder { call transfer };
allow hal_camera system_server:fd { use };
allow hal_camera vendor_adsprpc_prop:file { read getattr map open };
allow hal_camera vendor_camera_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_camera vendor_camera_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_camera vendor_camera_prop:file { read getattr map open };
allow hal_camera vendor_camera_prop:property_service { set };
allow hal_camera vendor_camera_sensor_prop:file { read getattr map open };
allow hal_camera vendor_camera_sensor_prop:property_service { set };
allow hal_camera vendor_qdisplay_service:service_manager { find };
allow hal_camera vendor_synx_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_camera vendor_sysfs_ddr:file { ioctl read getattr lock map open watch watch_reads };
allow hal_camera vendor_sysfs_jpeg:file { ioctl read getattr lock map open watch watch_reads };
allow hal_camera vendor_thermal-engine:unix_stream_socket { connectto };
allow hal_camera vendor_thermal_socket:sock_file { write };
allow hal_camera vendor_ubwcp_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allowxperm hal_camera self:qipcrtr_socket ioctl { 0xc300-0xc305 };
dontaudit hal_camera graphics_device:dir { search };
