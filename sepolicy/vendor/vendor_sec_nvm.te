# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_sec_nvm boot_status_prop:file { read getattr map open };
allow vendor_sec_nvm init:unix_stream_socket { connectto };
allow vendor_sec_nvm ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_sec_nvm mnt_vendor_file:dir { search };
allow vendor_sec_nvm property_socket:sock_file { write };
allow vendor_sec_nvm servicemanager:binder { call transfer };
allow vendor_sec_nvm servicemanager:fd { use };
allow vendor_sec_nvm tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_sec_nvm vendor_disable_spu_prop:file { read getattr map open };
allow vendor_sec_nvm vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_sec_nvm vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_sec_nvm vendor_dmabuf_secure_sp_tz_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
