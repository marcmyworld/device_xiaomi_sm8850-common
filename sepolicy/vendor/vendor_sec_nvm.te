allow vendor_sec_nvm vendor_spss_utils_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_sec_nvm vendor_sysfs_scsi_host:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_sec_nvm vendor_vm_cp_spss_hlos_shared_device:chr_file { ioctl read getattr lock map open watch watch_reads };
