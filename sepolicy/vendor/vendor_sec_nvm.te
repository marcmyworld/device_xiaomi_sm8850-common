allow vendor_sec_nvm vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_sec_nvm vendor_membuf_dev:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_sec_nvm vendor_persist_secnvm_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_sec_nvm vendor_persist_secnvm_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_sec_nvm vendor_persist_spudc_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_sec_nvm vendor_persist_spudc_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_sec_nvm vendor_qms:binder { call transfer };
allow vendor_sec_nvm vendor_qms:binder { transfer };
allow vendor_sec_nvm vendor_qms:fd { use };
allow vendor_sec_nvm vendor_qms_service:service_manager { find };
allow vendor_sec_nvm vendor_sec_nvm_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_sec_nvm vendor_sec_nvm_exec:file { read getattr map execute open entrypoint };
