# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_bluetooth bt_firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bluetooth bt_firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth bt_firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth fwk_scheduler_hwservice:hwservice_manager { find };
allow hal_bluetooth init:unix_stream_socket { connectto };
allow hal_bluetooth property_socket:sock_file { write };
allow hal_bluetooth self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_bluetooth serial_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth servicemanager:binder { call transfer };
allow hal_bluetooth servicemanager:fd { use };
allow hal_bluetooth system_app:binder { call transfer };
allow hal_bluetooth system_app:binder { transfer };
allow hal_bluetooth system_app:fd { use };
allow hal_bluetooth system_server:binder { call };
allow hal_bluetooth vendor_bluetooth_btadvaudio_prop:file { read getattr map open };
allow hal_bluetooth vendor_bluetooth_btadvaudio_prop:property_service { set };
allow hal_bluetooth vendor_bluetooth_prop:file { read getattr map open };
allow hal_bluetooth vendor_bluetooth_prop:property_service { set };
allow hal_bluetooth vendor_bluetooth_wifi_prop:file { read getattr map open };
allow hal_bluetooth vendor_bluetooth_wifi_prop:property_service { set };
allow hal_bluetooth vendor_bt_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth vendor_diag_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth vendor_proximity_prop:file { read getattr map open };
allow hal_bluetooth vendor_proximity_prop:property_service { set };
allow hal_bluetooth vendor_smd_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_bluetooth vendor_sysfs_diag:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_bluetooth vendor_sysfs_diag:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth vendor_sysfs_diag:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_bluetooth wifi_hal_prop:file { read getattr map open };
allowxperm hal_bluetooth self:socket ioctl { 0xc300-0xc305 };
