# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_usb_default hal_usb_default_exec:file { read getattr map execute open entrypoint };
allow hal_usb_default vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_usb_default vendor_sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_usb_default vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_usb_default vendor_sysfs_usbpd_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_usb_default vendor_sysfs_usbpd_device:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_usb_default vendor_sysfs_usbpd_device:lnk_file { ioctl read getattr lock map open watch watch_reads };
