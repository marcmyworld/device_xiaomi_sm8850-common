# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute surfaceflinger hal_uniperf_client;
typeattribute surfaceflinger hal_touchfeature_xiaomi_client;
typeattribute surfaceflinger vendor_hal_displayfeature_xiaomi_client;
typeattribute surfaceflinger dvs_aidl_client;
typeattribute surfaceflinger hal_visdisplaysrv_client;

allow surfaceflinger hal_fingerprint_default:binder { call transfer };
allow surfaceflinger hal_fingerprint_default:fd { use };
allow surfaceflinger hal_touchfeature_xiaomi_default:binder { call transfer };
allow surfaceflinger hal_touchfeature_xiaomi_default:fd { use };
allow surfaceflinger hal_touchfeature_xiaomi_service:service_manager { find };
allow surfaceflinger hal_visdisplaysrv_service:service_manager { find };
allow surfaceflinger input_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow surfaceflinger input_device:dir { ioctl read getattr lock open watch watch_reads search };
allow surfaceflinger perf_actuator_device:chr_file { ioctl read write open };
allow surfaceflinger servicemanager:binder { call transfer };
allow surfaceflinger surfaceflinger:netlink_socket { read write create bind };
allow surfaceflinger sysfs_touch_hostprocess:dir { ioctl read getattr lock open watch watch_reads search };
allow surfaceflinger sysfs_touch_hostprocess:file { ioctl read write getattr lock append map open watch watch_reads };
allow surfaceflinger vendor_display_prop:file { read getattr map open };
allow surfaceflinger vendor_displayfeature_device:chr_file { ioctl read write open };
allow surfaceflinger vendor_displayfeature_prop:file { read getattr map open };
allow surfaceflinger vendor_fp_prop:file { read getattr map open };
allow surfaceflinger vendor_gralloc_prop:file { read getattr map open };
allow surfaceflinger vendor_hal_fingerprint_hwservice_xiaomi:hwservice_manager { add find };
allow surfaceflinger vendor_hal_fingerprint_service_xiaomi:service_manager { find };
allow surfaceflinger vendor_hal_perf_default:binder { transfer };
allow surfaceflinger vendor_mfp-daemon:binder { call transfer };
allow surfaceflinger vendor_mfp-daemon:fd { use };
allow surfaceflinger vendor_sysfs_displayfeature:dir { ioctl read getattr lock open watch watch_reads search };
allow surfaceflinger vendor_sysfs_displayfeature:file { ioctl read write getattr lock append map open watch watch_reads };
allow surfaceflinger vendor_sysfs_graphics:dir { read open search };
allow surfaceflinger vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
allow surfaceflinger vendor_sysfs_kgsl:dir { ioctl read getattr lock open watch watch_reads search };
allow surfaceflinger vendor_sysfs_kgsl:file { ioctl read getattr lock map open watch watch_reads };
allow surfaceflinger vendor_sysfs_kgsl:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow surfaceflinger vendor_sysfs_qfprom:dir { ioctl read getattr lock open watch watch_reads search };
allow surfaceflinger vendor_sysfs_qfprom:file { ioctl read getattr lock map open watch watch_reads };
allow surfaceflinger vendor_sysfs_qfprom:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow surfaceflinger vendor_touchfeature_prop:file { read getattr map open };
allow surfaceflinger vendor_wlc_public_prop:file { read getattr map open };
allow surfaceflinger xr_fbt_device:chr_file { ioctl read write open };
dontaudit surfaceflinger firmware_file:dir { search };
dontaudit surfaceflinger kernel:system { module_request };
dontaudit surfaceflinger vendor_hal_qspmhal_hwservice:hwservice_manager { find };
dontaudit surfaceflinger vendor_hal_qspmhal_service:service_manager { find };
