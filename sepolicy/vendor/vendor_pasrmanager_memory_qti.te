# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_pasrmanager_memory_qti init:unix_stream_socket { connectto };
allow vendor_pasrmanager_memory_qti proc_meminfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_pasrmanager_memory_qti proc_zoneinfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_pasrmanager_memory_qti property_socket:sock_file { write };
allow vendor_pasrmanager_memory_qti sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_pasrmanager_memory_qti vendor_memory_min_free_kbytes:file { read getattr map open };
allow vendor_pasrmanager_memory_qti vendor_memory_min_free_kbytes:property_service { set };
allow vendor_pasrmanager_memory_qti vendor_pasr_prop:file { read getattr map open };
allow vendor_pasrmanager_memory_qti vendor_pasrmanager_memory_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_pasrmanager_memory_qti vendor_sysfs_mem_offline:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_pasrmanager_memory_qti vendor_sysfs_mem_offline:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_pasrmanager_memory_qti vendor_sysfs_system_memory:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_pasrmanager_memory_qti vendor_sysfs_system_memory:file { ioctl read write getattr lock append map open watch watch_reads };
