# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_ozonotify_client hal_ozonotify_hwservice:hwservice_manager { find };
allow hal_ozonotify_client hal_ozonotify_server:binder { call transfer };
allow hal_ozonotify_client hal_ozonotify_server:binder { transfer };
allow hal_ozonotify_client hal_ozonotify_server:fd { use };
allow hal_ozonotify_client hal_ozonotify_service:service_manager { find };
