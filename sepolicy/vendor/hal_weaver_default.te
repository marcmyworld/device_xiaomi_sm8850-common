# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute hal_weaver_default hal_miweaver_client;

allow hal_weaver_default boot_status_prop:file { read getattr map open };
allow hal_weaver_default hal_weaver_default_exec:file { read getattr map execute open entrypoint };
allow hal_weaver_default init:unix_stream_socket { connectto };
allow hal_weaver_default property_socket:sock_file { write };
allow hal_weaver_default self:capability2 { wake_alarm block_suspend };
allow hal_weaver_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_weaver_default vendor_payment_security_prop:file { read getattr map open };
allow hal_weaver_default vendor_payment_security_prop:property_service { set };
