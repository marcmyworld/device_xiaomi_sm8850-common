# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_miguardca_default, domain, hal_miguardca, hal_miguardca_server, halserverdomain;
type hal_miguardca_default_exec, exec_type, file_type, vendor_file_type;

allow hal_miguardca_default boot_status_prop:file { read getattr map open };
allow hal_miguardca_default hal_miguardca_default_exec:file { read getattr map execute open entrypoint };
allow hal_miguardca_default servicemanager:binder { call transfer };
allow hal_miguardca_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_miguardca_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read open };
allow hal_miguardca_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read open };
