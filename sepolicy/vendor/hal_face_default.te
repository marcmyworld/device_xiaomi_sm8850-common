# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_face_default fwk_sensor_service:service_manager { find };
allow hal_face_default hal_face_default_exec:file { read getattr map execute open entrypoint };
allow hal_face_default init:unix_stream_socket { connectto };
allow hal_face_default property_socket:sock_file { write };
allow hal_face_default virtual_face_prop:file { read getattr map open };
allow hal_face_default virtual_face_prop:property_service { set };
