allow vendor_hal_wigig property_socket:sock_file { write };
allow vendor_hal_wigig vendor_ctl_vendor_wigigsvc_prop:file { read getattr map open };
allow vendor_hal_wigig vendor_ctl_vendor_wigigsvc_prop:property_service { set };
allow vendor_hal_wigig vendor_wifi_vendor_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_wigig vendor_wifi_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_wigig vendor_wifi_vendor_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_wigig vendor_wifi_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_wigig vendor_wifi_vendor_data_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_wigig vendor_wifi_vendor_wpa_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_wigig vendor_wifi_vendor_wpa_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_wigig vendor_wigig_hostapd_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_wigig vendor_wigig_hostapd_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_wigig vendor_wigig_prop:file { read getattr map open };
allow vendor_hal_wigig vendor_wigig_prop:property_service { set };
allow vendor_hal_wigig vendor_wigig_vendor_wpa_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
