# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_biometricsface adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_biometricsface adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_biometricsface adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_biometricsface fwk_camera_hwservice:hwservice_manager { find };
allow vendor_biometricsface hidl_token_hwservice:hwservice_manager { find };
allow vendor_biometricsface tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_biometricsface vendor_adsprpc_prop:file { read getattr map open };
allow vendor_biometricsface vendor_biometricsface_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_biometricsface vendor_biometricsface_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_biometricsface vendor_biometricsface_exec:file { read getattr map execute open entrypoint };
allow vendor_biometricsface vendor_dmabuf_secure_cdsp_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_biometricsface vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_biometricsface vendor_dmabuf_user_contig_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_biometricsface vendor_face3d_producer_prop:file { read getattr map open };
dontaudit vendor_biometricsface system_file:file { ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads execute_no_trans entrypoint };
