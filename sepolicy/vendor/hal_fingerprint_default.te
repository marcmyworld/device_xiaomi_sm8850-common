allow hal_fingerprint_default input_device:chr_file { ioctl read write getattr lock append map execute open watch watch_reads execute_no_trans };
allow hal_fingerprint_default input_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_fingerprint_default mnt_vendor_file:dir { search };
allow hal_fingerprint_default platform_app_all:binder { call transfer };
allow hal_fingerprint_default platform_app_all:binder { transfer };
allow hal_fingerprint_default platform_app_all:fd { use };
allow hal_fingerprint_default property_socket:sock_file { write };
allow hal_fingerprint_default self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_fingerprint_default surfaceflinger:binder { transfer };
allow hal_fingerprint_default sysfs:file { write };
allow hal_fingerprint_default system_app:binder { call transfer };
allow hal_fingerprint_default system_app:binder { transfer };
allow hal_fingerprint_default system_app:fd { use };
allow hal_fingerprint_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_fingerprint_default uhid_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_fingerprint_default vendor_fingerprint_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_fingerprint_default vendor_fingerprint_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_fingerprint_default vendor_fingerprint_data_file_fpdump:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_fingerprint_default vendor_fingerprint_data_file_fpdump:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_fingerprint_default vendor_fingerprint_device:chr_file { ioctl read write getattr lock append map execute open watch watch_reads execute_no_trans };
allow hal_fingerprint_default vendor_fp_info_prop:file { read getattr map open };
allow hal_fingerprint_default vendor_fp_info_prop:property_service { set };
allow hal_fingerprint_default vendor_fp_prop:file { read getattr map open };
allow hal_fingerprint_default vendor_fp_prop:property_service { set };
