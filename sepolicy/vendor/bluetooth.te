# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute bluetooth hal_touchfeature_xiaomi_client;
typeattribute bluetooth hal_micharge_client;
typeattribute bluetooth vendor_hal_citsensorservice_xiaomi_client;

allow bluetooth gpuservice:binder { call transfer };
allow bluetooth gpuservice:fd { use };
allow bluetooth hal_audio:binder { call transfer };
allow bluetooth hal_audio:binder { transfer };
allow bluetooth hal_audio:fd { use };
allow bluetooth hal_audio_hwservice:hwservice_manager { find };
allow bluetooth hal_touchfeature_xiaomi_default:binder { call transfer };
allow bluetooth hal_touchfeature_xiaomi_default:fd { use };
allow bluetooth hal_touchfeature_xiaomi_service:service_manager { find };
allow bluetooth init:unix_stream_socket { connectto };
allow bluetooth media_rw_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow bluetooth media_rw_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow bluetooth property_socket:sock_file { write };
allow bluetooth self:socket { ioctl };
allow bluetooth self:socket { read write create getopt };
allow bluetooth serial_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow bluetooth servicemanager:binder { call transfer };
allow bluetooth servicemanager:fd { use };
allow bluetooth sysfs_bluetooth_writable:file { write lock append map open };
allow bluetooth system_app:binder { call transfer };
allow bluetooth system_app:fd { use };
allow bluetooth system_app_data_file:dir { getattr };
allow bluetooth system_app_data_file:file { read getattr open };
allow bluetooth uhid_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow bluetooth vendor_audio_cloud_ctrl_mi_prop:file { read getattr map open };
allow bluetooth vendor_audio_prop:file { read getattr map open };
allow bluetooth vendor_bluetooth_a2dp_mi_prop:file { read getattr map open };
allow bluetooth vendor_bluetooth_a2dp_mi_prop:property_service { set };
allow bluetooth vendor_bluetooth_prop:file { read getattr map open };
allow bluetooth vendor_bt_data_file:dir { search };
allow bluetooth vendor_bt_data_file:file { read getattr open };
allow bluetooth vendor_bt_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow bluetooth vendor_default_prop:file { getattr map };
allow bluetooth vendor_display_prop:file { read getattr map open };
allow bluetooth vendor_dun_service:service_manager { find };
allow bluetooth vendor_hal_citsensorservice_xiaomi_default:binder { call };
allow bluetooth vendor_smd_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allowxperm bluetooth self:socket ioctl { 0xc300-0xc305 };
allowxperm bluetooth self:udp_socket ioctl { 0x6900 0x6902 };
allowxperm bluetooth self:udp_socket ioctl { 0x890b-0x890d 0x8911 0x8914 0x8916 0x8918 0x891a 0x891c-0x8920 0x8922-0x8927 0x8929 0x8930-0x8932 0x8934-0x8937 0x8939 0x8940-0x8941 0x8943 0x8946-0x894b 0x8953-0x8955 0x8960-0x8962 0x8970-0x8971 0x8980-0x8983 0x8990-0x8995 0x89a0-0x89a3 0x89b0 0x89e0-0x89ff };
allowxperm bluetooth self:udp_socket ioctl { 0x8b00 0x8b02 0x8b04 0x8b06 0x8b08 0x8b0a 0x8b0c 0x8b0e 0x8b10 0x8b14-0x8b1d 0x8b20 0x8b22 0x8b24 0x8b26 0x8b28 0x8b2a-0x8b2c 0x8b30-0x8b36 0x8be0-0x8bff };
dontaudit bluetooth netd_service:service_manager { find };
