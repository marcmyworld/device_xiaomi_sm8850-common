# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute untrusted_app_30 hal_mediaeventgatherservice_client;
typeattribute untrusted_app_30 hal_videoservice_client;
typeattribute untrusted_app_30 dvs_aidl_client;

allow untrusted_app_30 hal_mediaeventgatherservice:binder { call };
allow untrusted_app_30 hal_mediaeventgatherservice_service:fd { use };
allow untrusted_app_30 hal_mediaeventgatherservice_service:service_manager { find };
allow untrusted_app_30 hal_ozonotify:binder { call transfer };
allow untrusted_app_30 hal_ozonotify:binder { transfer };
allow untrusted_app_30 hal_ozonotify:fd { use };
allow untrusted_app_30 hal_ozonotify_hwservice:hwservice_manager { find };
allow untrusted_app_30 hal_ozonotify_service:service_manager { find };
allow untrusted_app_30 servicemanager:binder { call transfer };
allow untrusted_app_30 sound_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow untrusted_app_30 vendor_audio_prop:file { read getattr map open };
allow untrusted_app_30 vendor_fp_prop:file { read getattr map open };
