# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute mediaserver hal_mediaeventgatherservice_client;
typeattribute mediaserver hal_videoservice_client;
typeattribute mediaserver dvs_aidl_client;

allow mediaserver hal_cstransfer:binder { call transfer };
allow mediaserver hal_cstransfer:fd { use };
allow mediaserver hal_mediaeventgatherservice:binder { call };
allow mediaserver hal_mediaeventgatherservice_service:fd { use };
allow mediaserver hal_mediaeventgatherservice_service:service_manager { find };
allow mediaserver hal_ozonotify:binder { call transfer };
allow mediaserver hal_ozonotify:fd { use };
allow mediaserver hal_ozonotify_default:binder { call };
allow mediaserver hal_ozonotify_hwservice:hwservice_manager { find };
allow mediaserver hal_ozonotify_service:service_manager { find };
allow mediaserver hal_seaaudio:binder { call transfer };
allow mediaserver hal_seaaudio:fd { use };
allow mediaserver hal_seaaudio_default:binder { call };
allow mediaserver servicemanager:binder { call transfer };
allow mediaserver sound_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow mediaserver sysfs_bmark_group:dir { search };
allow mediaserver sysfs_bmark_group:file { ioctl read write getattr setattr lock append map open watch watch_reads };
allow mediaserver vendor_audio_cloud_ctrl_mi_prop:file { read getattr map open };
allow mediaserver vendor_audio_prop:file { read getattr map open };
allow mediaserver vendor_sys_video_prop:file { read };
allow mediaserver vendor_video_prop:file { read getattr map open };
dontaudit mediaserver vendor_hal_qspmhal_hwservice:hwservice_manager { find };
dontaudit mediaserver vendor_hal_qspmhal_service:service_manager { find };
