# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type vendor_mfp-daemon, domain, hal_fingerprint, hal_fingerprint_server, hal_touchfeature_xiaomi_client, halclientdomain, halserverdomain, vendor_hal_perf_client;
type vendor_mfp-daemon_data_file, data_file_type, file_type;
type vendor_mfp-daemon_exec, exec_type, file_type, vendor_file_type;

allow vendor_mfp-daemon dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
