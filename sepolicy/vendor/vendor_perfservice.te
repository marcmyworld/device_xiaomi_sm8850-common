# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_perfservice sysfs_freq_qos_dump:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_perfservice vendor_iop_prop:file { read getattr map open };
