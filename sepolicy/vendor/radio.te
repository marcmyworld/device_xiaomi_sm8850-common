# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute radio hal_misys_vendor_client;
typeattribute radio hal_vsimapp_client;
typeattribute radio hal_videoservice_client;
typeattribute radio hal_miqms_client;
typeattribute radio vendor_hal_citsensorservice_xiaomi_client;

allow radio fuse:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow radio fuse:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow radio hwservicemanager:binder { call transfer };
allow radio logd_prop:property_service { set };
allow radio mediaextractor_service:service_manager { find };
allow radio proc_ramdump:file { ioctl read write getattr lock append map open watch watch_reads };
allow radio radio_service:service_manager { add find };
allow radio servicemanager:binder { call transfer };
allow radio vendor_atfwd:binder { transfer };
allow radio vendor_audio_prop:file { getattr };
allow radio vendor_audio_prop:file { map };
allow radio vendor_audio_prop:file { open };
allow radio vendor_audio_prop:file { read };
allow radio vendor_avtimer_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow radio vendor_bsp_data_log_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow radio vendor_bsp_data_log_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow radio vendor_cnd:binder { call transfer };
allow radio vendor_cnd:fd { use };
allow radio vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow radio vendor_framework_file:dir { search };
allow radio vendor_framework_file:file { ioctl read getattr lock map open watch watch_reads };
allow radio vendor_hal_citsensorservice_xiaomi_default:binder { call };
allow radio vendor_hal_citsensorservice_xiaomi_service:service_manager { find };
allow radio vendor_hal_latency_hwservice:hwservice_manager { find };
allow radio vendor_modem_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow radio vendor_modem_data_file:file { read write create getattr unlink open };
allow radio vendor_radio_prop:file { read getattr map open };
allow radio vendor_ramdump_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow radio vendor_ramdump_vendor_data_file:fifo_file { read write create open };
allow radio vendor_ramdump_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow radio vendor_sysfs_qcom_battery:dir { ioctl read getattr lock open watch watch_reads search };
allow radio vendor_sysfs_qcom_battery:dir { search };
allow radio vendor_sysfs_qcom_battery:file { ioctl read write getattr lock append map open watch watch_reads };
allow radio wificond:binder { call transfer };
allow radio wifinl80211_service:service_manager { find };
