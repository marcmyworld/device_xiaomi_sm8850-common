# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vold mnt_vendor_file:dir { ioctl read open };
allow vold vendor_sysfs_mmc_host:file { write lock append map open };
allow vold vendor_tee_listener_prop:file { read getattr map open };
