# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_mdm_helper block_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mdm_helper firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mdm_helper firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mdm_helper firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mdm_helper hal_system_suspend_service:service_manager { find };
allow vendor_mdm_helper hidl_manager_hwservice:hwservice_manager { find };
allow vendor_mdm_helper hwservicemanager:binder { call transfer };
allow vendor_mdm_helper hwservicemanager_prop:file { read getattr map open };
allow vendor_mdm_helper self:cap2_userns { block_suspend };
allow vendor_mdm_helper self:capability { kill };
allow vendor_mdm_helper self:capability2 { block_suspend };
allow vendor_mdm_helper servicemanager:binder { call transfer };
allow vendor_mdm_helper sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mdm_helper system_suspend_hwservice:hwservice_manager { find };
allow vendor_mdm_helper system_suspend_server:binder { call transfer };
allow vendor_mdm_helper system_suspend_server:fd { use };
allow vendor_mdm_helper vendor_efs_boot_dev:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mdm_helper vendor_esoc_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mdm_helper vendor_esoc_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mdm_helper vendor_mdm_helper_exec:file { getattr map execute execute_no_trans };
allow vendor_mdm_helper vendor_mdm_helper_exec:file { read getattr map execute open entrypoint };
allow vendor_mdm_helper vendor_mhi_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mdm_helper vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_mdm_helper vendor_ssr_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mdm_helper vendor_tombstone_data_file:dir { ioctl read getattr lock open watch watch_reads search };
dontaudit vendor_mdm_helper vendor_tombstone_data_file:dir { write };
