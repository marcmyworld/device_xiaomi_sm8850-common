# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_batteryantiaging_server hal_batteryantiaging_client:binder { call transfer };
allow hal_batteryantiaging_server hal_batteryantiaging_client:binder { transfer };
allow hal_batteryantiaging_server hal_batteryantiaging_client:fd { use };
allow hal_batteryantiaging_server hal_batteryantiaging_service:service_manager { add find };
