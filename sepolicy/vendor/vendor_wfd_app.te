# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

dontaudit vendor_wfd_app gpuservice:binder { call };
dontaudit vendor_wfd_app vendor_hal_perf2_service:service_manager { find };
dontaudit vendor_wfd_app vendor_hal_perf_hwservice:hwservice_manager { find };
