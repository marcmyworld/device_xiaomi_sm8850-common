# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mikeybag_server hal_mikeybag_client:binder { call transfer };
allow hal_mikeybag_server hal_mikeybag_client:binder { transfer };
allow hal_mikeybag_server hal_mikeybag_client:fd { use };
allow hal_mikeybag_server hal_mikeybag_service:service_manager { add find };
allow hal_mikeybag_server servicemanager:binder { call transfer };
allow hal_mikeybag_server servicemanager:fd { use };
