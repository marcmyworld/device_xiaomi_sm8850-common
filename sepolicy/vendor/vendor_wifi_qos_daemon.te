# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_wifi_qos_daemon hal_wifi_supplicant_default:unix_dgram_socket { sendto };
allow vendor_wifi_qos_daemon self:capability { net_admin };
allow vendor_wifi_qos_daemon self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_wifi_qos_daemon self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_wifi_qos_daemon vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_wifi_qos_daemon vendor_ssgtzd_socket:sock_file { write };
allow vendor_wifi_qos_daemon vendor_txpb_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_wifi_qos_daemon vendor_wifi_qos_daemon_exec:file { read getattr map execute open entrypoint };
allow vendor_wifi_qos_daemon vendor_wifi_tx_powerboost_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_wifi_qos_daemon vendor_wifi_tx_powerboost_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_wifi_qos_daemon vendor_wifi_vendor_data_file:dir { search };
allow vendor_wifi_qos_daemon wpa_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_wifi_qos_daemon wpa_data_file:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allowxperm vendor_wifi_qos_daemon self:udp_socket ioctl { 0x8914 };
allowxperm vendor_wifi_qos_daemon self:udp_socket ioctl { 0x8be5 };
dontaudit vendor_wifi_qos_daemon default_prop:file { read };
