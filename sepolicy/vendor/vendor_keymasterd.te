# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_keymasterd tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_keymasterd vendor_keymasterd_exec:file { read getattr map execute open entrypoint };
allow vendor_keymasterd vendor_skp_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_sp_keymaster_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_sp_keymaster_ssr_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_sp_ssr_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_spcom_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_spcomlib_prop:file { read getattr map open };
allow vendor_keymasterd vendor_spss_utils_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_keymasterd vendor_tee_listener_prop:file { read getattr map open };
