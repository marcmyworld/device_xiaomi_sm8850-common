# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_hwcrypto_default hal_hwcrypto_default_exec:file { read getattr map execute open entrypoint };
allow hal_hwcrypto_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_hwcrypto_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
