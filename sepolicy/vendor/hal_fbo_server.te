# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_fbo_server hal_fbo_client:binder { call transfer };
allow hal_fbo_server hal_fbo_client:binder { transfer };
allow hal_fbo_server hal_fbo_client:fd { use };
allow hal_fbo_server hal_fbo_service:service_manager { add find };
