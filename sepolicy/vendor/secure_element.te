# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow secure_element hal_authsecret_default:binder { transfer };
allow secure_element vendor_hal_keymint_strongbox:binder { transfer };
allow secure_element vendor_hal_weaver_default:binder { transfer };
allow secure_element vendor_nfc_mi_prop:file { read getattr map open };
