# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_display_color hal_graphics_composer:binder { call transfer };
allow vendor_hal_display_color hal_graphics_composer:fd { use };
allow vendor_hal_display_color hal_graphics_composer_default:unix_stream_socket { connectto };
allow vendor_hal_display_color init:unix_stream_socket { connectto };
allow vendor_hal_display_color property_socket:sock_file { write };
allow vendor_hal_display_color vendor_pps_socket:sock_file { write };
allow vendor_hal_display_color vendor_qdcmss_prop:file { read getattr map open };
allow vendor_hal_display_color vendor_qdcmss_prop:property_service { set };
allow vendor_hal_display_color vendor_qdisplay_service:service_manager { find };
allow vendor_hal_display_color vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_display_color vndservicemanager:binder { call transfer };
