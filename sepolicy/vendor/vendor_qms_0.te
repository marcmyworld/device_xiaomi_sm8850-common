# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qms_0 anr_data_file:file { append };
allow vendor_qms_0 bpfloader:bpf { map_read map_write };
allow vendor_qms_0 dumpstate:fd { use };
allow vendor_qms_0 dumpstate:fifo_file { write append };
allow vendor_qms_0 fs_bpf_vendor:dir { search };
allow vendor_qms_0 fs_bpf_vendor:file { read write getattr };
allow vendor_qms_0 incidentd:fd { use };
allow vendor_qms_0 incidentd:fifo_file { write append };
allow vendor_qms_0 self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_qms_0 system_server:fifo_file { write append };
allow vendor_qms_0 tombstone_data_file:file { append };
allow vendor_qms_0 tombstoned:fd { use };
allow vendor_qms_0 tombstoned:unix_stream_socket { connectto };
allow vendor_qms_0 tombstoned_crash_socket:sock_file { write };
allow vendor_qms_0 vendor_qms:fd { use };
allow vendor_qms_0 vendor_qms:unix_dgram_socket { write };
allow vendor_qms_0 vendor_qms:unix_stream_socket { read write };
allow vendor_qms_0 vendor_qms_config_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qms_0 vendor_qms_config_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qms_0 vendor_qms_exec:file { execute_no_trans };
allow vendor_qms_0 vendor_qms_other_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_qms_0 vendor_qms_other_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
