# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow lmkd camlog_device:chr_file { ioctl read write open };
allow lmkd hwservicemanager:binder { call };
allow lmkd hwservicemanager_prop:file { read getattr map open };
allow lmkd self:cap2_userns { block_suspend };
allow lmkd self:capability2 { block_suspend };
allow lmkd vendor_hal_perf_default:binder { call };
allow lmkd vendor_hal_perf_hwservice:hwservice_manager { find };
