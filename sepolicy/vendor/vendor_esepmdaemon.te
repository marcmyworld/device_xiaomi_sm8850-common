# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_esepmdaemon firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_esepmdaemon firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_esepmdaemon firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_esepmdaemon ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_esepmdaemon nfc_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_esepmdaemon system_app:binder { call transfer };
allow vendor_esepmdaemon system_app:fd { use };
allow vendor_esepmdaemon tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_esepmdaemon vendor_esepmdaemon_exec:file { read getattr map execute open entrypoint };
allow vendor_esepmdaemon vendor_esepmdaemon_service:service_manager { add find };
allow vendor_esepmdaemon vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_esepmdaemon vndservicemanager:binder { call transfer };
