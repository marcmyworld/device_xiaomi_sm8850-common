# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_dataservice_app vendor_cnd_prop:file { read getattr map open };
allow vendor_dataservice_app vendor_hal_slmadapter_hwservice:hwservice_manager { find };
allow vendor_dataservice_app vendor_mwqem_prop:file { read getattr map open };
allow vendor_dataservice_app vendor_slm_prop:file { read getattr map open };
allow vendor_dataservice_app vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };
