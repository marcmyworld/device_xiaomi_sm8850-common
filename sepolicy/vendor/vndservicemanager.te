# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vndservicemanager ctl_interface_start_prop:file { read getattr map open };
allow vndservicemanager ctl_interface_start_prop:property_service { set };
allow vndservicemanager init:unix_stream_socket { connectto };
allow vndservicemanager kernel:security { compute_av };
allow vndservicemanager kmsg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vndservicemanager property_socket:sock_file { write };
allow vndservicemanager self:binder { set_context_mgr };
allow vndservicemanager self:netlink_selinux_socket { read write create getattr setattr lock relabelfrom relabelto append bind connect listen accept getopt setopt shutdown recvfrom sendto name_bind };
allow vndservicemanager selinuxfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vndservicemanager selinuxfs:file { ioctl read getattr lock map open watch watch_reads };
allow vndservicemanager selinuxfs:file { write lock append map open };
allow vndservicemanager selinuxfs:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vndservicemanager service_manager_vndservice:service_manager { add find };
allow vndservicemanager vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vndservicemanager vndservice_contexts_file:file { ioctl read getattr lock map open watch watch_reads };
allow vndservicemanager vndservicemanager_exec:file { read getattr map execute open entrypoint };
