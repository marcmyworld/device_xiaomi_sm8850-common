# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute nfc hal_micharge_client;

allow nfc cameraserver:binder { call transfer };
allow nfc cameraserver_service:service_manager { find };
allow nfc servicemanager:binder { call transfer };
allow nfc system_app_service:service_manager { find };
allow nfc vendor_audio_prop:file { read getattr map open };
allow nfc vendor_fp_prop:file { read getattr map open };
allow nfc vendor_hal_nxpnfc_service:service_manager { find };
allow nfc vendor_nfc_mi_prop:file { read getattr map open };
allow nfc vendor_nfc_nq_prop:file { read getattr map open };
allow nfc vendor_nfc_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow nfc vendor_nfc_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow nfc vendor_sysfs_qcom_battery:dir { getattr open search };
allow nfc vendor_sysfs_qcom_battery:file { read getattr open };
