# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_install_recovery block_device:dir { search };
allow vendor_install_recovery boot_block_device:blk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_install_recovery proc_drop_caches:file { write lock append map open };
allow vendor_install_recovery recovery_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_install_recovery vendor_file:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_install_recovery vendor_install_recovery_exec:file { read getattr map execute open entrypoint };
allow vendor_install_recovery vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_install_recovery vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
