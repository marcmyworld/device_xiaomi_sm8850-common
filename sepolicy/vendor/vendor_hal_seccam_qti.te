# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_seccam_qti init:unix_stream_socket { connectto };
allow vendor_hal_seccam_qti property_socket:sock_file { write };
allow vendor_hal_seccam_qti vendor_core_ctl_prop:file { read getattr map open };
allow vendor_hal_seccam_qti vendor_core_ctl_prop:property_service { set };
allow vendor_hal_seccam_qti vendor_hal_seccam_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_seccam_qti video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
