# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_bluetooth_btlinux hal_bluetooth_btlinux_exec:file { read getattr map execute open entrypoint };
allow hal_bluetooth_btlinux self:bluetooth_socket { read write create bind };
allow hal_bluetooth_btlinux self:socket { read write create bind };
