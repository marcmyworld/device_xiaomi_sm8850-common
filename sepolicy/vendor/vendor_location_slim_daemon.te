# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_location_slim_daemon fwk_sensor_hwservice:hwservice_manager { find };
allow vendor_location_slim_daemon fwk_sensor_service:service_manager { find };
allow vendor_location_slim_daemon hwservicemanager:binder { call transfer };
allow vendor_location_slim_daemon hwservicemanager_prop:file { read getattr map open };
allow vendor_location_slim_daemon self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_location_slim_daemon servicemanager:binder { call transfer };
allow vendor_location_slim_daemon servicemanager:fd { use };
allow vendor_location_slim_daemon system_server:binder { call transfer };
allow vendor_location_slim_daemon system_server:binder { transfer };
allow vendor_location_slim_daemon system_server:fd { use };
allow vendor_location_slim_daemon vendor_hal_gnss_qti:unix_dgram_socket { sendto };
allow vendor_location_slim_daemon vendor_location:fd { use };
allow vendor_location_slim_daemon vendor_location:process { sigchld };
allow vendor_location_slim_daemon vendor_location:unix_dgram_socket { read write sendto };
allow vendor_location_slim_daemon vendor_location_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_location_slim_daemon vendor_location_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_location_slim_daemon vendor_location_lowi_server:unix_dgram_socket { sendto };
allow vendor_location_slim_daemon vendor_location_slim_daemon_exec:file { read getattr map execute open entrypoint };
allow vendor_location_slim_daemon vendor_location_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_location_slim_daemon vendor_location_socket:lnk_file { read getattr open };
allow vendor_location_slim_daemon vendor_location_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_location_slim_daemon vendor_location_xtwifi_client:unix_dgram_socket { sendto };
allow vendor_location_slim_daemon vendor_qms_prop:file { read getattr map open };
