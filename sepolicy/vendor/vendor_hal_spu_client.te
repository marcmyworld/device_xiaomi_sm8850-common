# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_spu_client servicemanager:binder { call transfer };
allow vendor_hal_spu_client servicemanager:fd { use };
allow vendor_hal_spu_client vendor_hal_spu_hwservice:hwservice_manager { find };
allow vendor_hal_spu_client vendor_hal_spu_server:binder { call transfer };
allow vendor_hal_spu_client vendor_hal_spu_server:binder { transfer };
allow vendor_hal_spu_client vendor_hal_spu_server:fd { use };
allow vendor_hal_spu_client vendor_hal_spu_service:service_manager { find };
