# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_mlipay_server hal_mlipay_client:binder { call transfer };
allow hal_mlipay_server hal_mlipay_client:binder { transfer };
allow hal_mlipay_server hal_mlipay_client:fd { use };
allow hal_mlipay_server hal_mlipay_service:service_manager { add find };
allow hal_mlipay_server servicemanager:binder { call transfer };
allow hal_mlipay_server servicemanager:fd { use };
