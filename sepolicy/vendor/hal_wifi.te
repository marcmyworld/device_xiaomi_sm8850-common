# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_wifi proc_net:file { write };
allow hal_wifi vendor_location:unix_stream_socket { connectto };
allow hal_wifi vendor_location_lowi_server:unix_stream_socket { connectto };
allow hal_wifi vendor_location_socket:sock_file { write };
allow hal_wifi vendor_wlan_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
