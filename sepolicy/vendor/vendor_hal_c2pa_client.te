# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_c2pa_client vendor_hal_c2pa_aidl_service:service_manager { find };
allow vendor_hal_c2pa_client vendor_hal_c2pa_qti_tmpfs:file { read };
allow vendor_hal_c2pa_client vendor_hal_c2pa_server:binder { call transfer };
allow vendor_hal_c2pa_client vendor_hal_c2pa_server:binder { transfer };
allow vendor_hal_c2pa_client vendor_hal_c2pa_server:fd { use };
