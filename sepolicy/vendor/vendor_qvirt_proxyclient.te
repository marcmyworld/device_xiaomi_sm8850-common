# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qvirt_proxyclient boot_status_prop:file { read getattr map open };
allow vendor_qvirt_proxyclient init:unix_stream_socket { connectto };
allow vendor_qvirt_proxyclient property_socket:sock_file { write };
allow vendor_qvirt_proxyclient servicemanager:binder { call transfer };
allow vendor_qvirt_proxyclient vendor_mi_qvirtmgr_prop:file { read getattr map open };
allow vendor_qvirt_proxyclient vendor_mi_qvirtmgr_prop:property_service { set };
allow vendor_qvirt_proxyclient vendor_mitee_prop:file { read getattr map open };
allow vendor_qvirt_proxyclient vendor_mitee_prop:property_service { set };
allow vendor_qvirt_proxyclient vendor_modprobe_prop:file { read getattr map open };
allow vendor_qvirt_proxyclient vendor_qtvm_autostart_prop:file { read getattr map open };
allow vendor_qvirt_proxyclient vendor_qvirt_proxyclient_exec:file { read getattr map execute open entrypoint };
