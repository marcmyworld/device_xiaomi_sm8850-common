# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_mstatservice proc_net_tcp_udp:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_mstatservice proc_net_tcp_udp:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_mstatservice proc_net_tcp_udp:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_mstatservice vendor_hal_mstatservice_exec:file { read getattr map execute open entrypoint };
