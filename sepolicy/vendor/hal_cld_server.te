# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_cld_server hal_cld_client:binder { call transfer };
allow hal_cld_server hal_cld_client:binder { transfer };
allow hal_cld_server hal_cld_client:fd { use };
allow hal_cld_server hal_cld_service:service_manager { add find };
