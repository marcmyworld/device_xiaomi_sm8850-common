# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_uwb_default bt_firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_uwb_default bt_firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_uwb_default bt_firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_uwb_default hal_system_suspend_service:service_manager { find };
allow hal_uwb_default hal_uwb_default_exec:file { read getattr map execute open entrypoint };
allow hal_uwb_default hidl_manager_hwservice:hwservice_manager { find };
allow hal_uwb_default hwservicemanager:binder { call transfer };
allow hal_uwb_default hwservicemanager_prop:file { read getattr map open };
allow hal_uwb_default mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_uwb_default mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_uwb_default mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_uwb_default self:cap2_userns { block_suspend };
allow hal_uwb_default self:capability2 { block_suspend };
allow hal_uwb_default servicemanager:binder { call transfer };
allow hal_uwb_default sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_uwb_default system_suspend_hwservice:hwservice_manager { find };
allow hal_uwb_default system_suspend_server:binder { call transfer };
allow hal_uwb_default system_suspend_server:fd { use };
allow hal_uwb_default vendor_persist_uwb_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_uwb_default vendor_persist_uwb_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
