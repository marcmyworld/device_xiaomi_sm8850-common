# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type vendor_hal_miaon_frame_default, domain, hal_graphics_allocator_client, halclientdomain, halserverdomain, vendor_hal_dspmanager_client, vendor_hal_miaon_frame, vendor_hal_miaon_frame_server;
type vendor_hal_miaon_frame_default_exec, exec_type, file_type, vendor_file_type;

allow vendor_hal_miaon_frame_default adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_miaon_frame_default adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_miaon_frame_default adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_miaon_frame_default dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_miaon_frame_default fwk_sensor_hwservice:hwservice_manager { find };
allow vendor_hal_miaon_frame_default hal_graphics_allocator_default:binder { call transfer };
allow vendor_hal_miaon_frame_default hal_graphics_allocator_default:fd { use };
allow vendor_hal_miaon_frame_default hal_graphics_mapper_hwservice:hwservice_manager { find };
allow vendor_hal_miaon_frame_default hal_miface_default:binder { transfer };
allow vendor_hal_miaon_frame_default hidl_token_hwservice:hwservice_manager { find };
allow vendor_hal_miaon_frame_default init:unix_stream_socket { connectto };
allow vendor_hal_miaon_frame_default property_socket:sock_file { write };
allow vendor_hal_miaon_frame_default self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hal_miaon_frame_default self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hal_miaon_frame_default servicemanager:binder { call transfer };
allow vendor_hal_miaon_frame_default vendor_adsprpc_prop:file { read getattr map open };
allow vendor_hal_miaon_frame_default vendor_aon_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_hal_miaon_frame_default vendor_aon_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_miaon_frame_default vendor_display_prop:file { read getattr map open };
allow vendor_hal_miaon_frame_default vendor_hal_miaon_frame_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_miaon_frame_default vendor_system_prop:file { read getattr map open };
allow vendor_hal_miaon_frame_default vendor_system_prop:property_service { set };
allowxperm vendor_hal_miaon_frame_default self:qipcrtr_socket ioctl { 0xc300-0xc305 };
allowxperm vendor_hal_miaon_frame_default self:socket ioctl { 0xc300-0xc305 };
