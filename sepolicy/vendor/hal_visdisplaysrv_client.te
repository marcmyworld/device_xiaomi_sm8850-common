# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_visdisplaysrv_client hal_visdisplaysrv_server:binder { call transfer };
allow hal_visdisplaysrv_client hal_visdisplaysrv_server:binder { transfer };
allow hal_visdisplaysrv_client hal_visdisplaysrv_server:fd { use };
allow hal_visdisplaysrv_client hal_visdisplaysrv_service:service_manager { find };
