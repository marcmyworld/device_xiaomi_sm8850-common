# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_embmssl_app app_api_service:service_manager { find };
allow vendor_embmssl_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_embmssl_app radio_service:service_manager { find };
allow vendor_embmssl_app vendor_dpmd:unix_stream_socket { connectto };
allow vendor_embmssl_app vendor_dpmtcm_socket:sock_file { write };
allow vendor_embmssl_app vendor_embmssl_app_userfaultfd:anon_inode { ioctl read create };
allowxperm vendor_embmssl_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
dontaudit vendor_embmssl_app system_file:dir { write };
