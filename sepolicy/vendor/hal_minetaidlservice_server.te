# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_minetaidlservice_server hal_minetaidlservice_client:binder { call transfer };
allow hal_minetaidlservice_server hal_minetaidlservice_client:binder { transfer };
allow hal_minetaidlservice_server hal_minetaidlservice_client:fd { use };
allow hal_minetaidlservice_server hal_minetaidlservice_service:service_manager { add find };
allow hal_minetaidlservice_server servicemanager:binder { call transfer };
allow hal_minetaidlservice_server servicemanager:fd { use };
