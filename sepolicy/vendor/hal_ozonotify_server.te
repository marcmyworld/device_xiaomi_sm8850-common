# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_ozonotify_server dumpstate:fd { use };
allow hal_ozonotify_server dumpstate:fifo_file { write };
allow hal_ozonotify_server hal_ozonotify_client:binder { call transfer };
allow hal_ozonotify_server hal_ozonotify_client:binder { transfer };
allow hal_ozonotify_server hal_ozonotify_client:fd { use };
allow hal_ozonotify_server hal_ozonotify_hwservice:hwservice_manager { add find };
allow hal_ozonotify_server hal_ozonotify_service:service_manager { add find };
allow hal_ozonotify_server hidl_base_hwservice:hwservice_manager { add };
