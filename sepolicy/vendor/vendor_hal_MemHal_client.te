# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_MemHal_client vendor_hal_MemHal_server:binder { call transfer };
allow vendor_hal_MemHal_client vendor_hal_MemHal_server:fd { use };
allow vendor_hal_MemHal_client vendor_hal_MemHal_service:service_manager { find };
