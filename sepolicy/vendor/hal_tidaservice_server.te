# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_tidaservice_server hal_tidaservice_client:binder { call transfer };
allow hal_tidaservice_server hal_tidaservice_client:binder { transfer };
allow hal_tidaservice_server hal_tidaservice_client:fd { use };
allow hal_tidaservice_server hal_tidaservice_service:service_manager { add find };
allow hal_tidaservice_server servicemanager:binder { call transfer };
allow hal_tidaservice_server servicemanager:fd { use };
