# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_imshelper_app app_api_service:service_manager { find };
allow vendor_imshelper_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_imshelper_app system_app_data_file:dir { getattr search };
allow vendor_imshelper_app vendor_ims_service:unix_stream_socket { connectto };
allow vendor_imshelper_app vendor_ims_service_socket:sock_file { write };
allow vendor_imshelper_app vendor_imshelper_app_userfaultfd:anon_inode { ioctl read create };
allow vendor_imshelper_app vendor_radio_data_file:dir { getattr search };
allowxperm vendor_imshelper_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
