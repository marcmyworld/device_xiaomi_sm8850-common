# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_midevauth_server hal_midevauth_client:binder { call transfer };
allow hal_midevauth_server hal_midevauth_client:binder { transfer };
allow hal_midevauth_server hal_midevauth_client:fd { use };
allow hal_midevauth_server hal_midevauth_service:service_manager { add find };
allow hal_midevauth_server servicemanager:binder { call transfer };
allow hal_midevauth_server servicemanager:fd { use };
