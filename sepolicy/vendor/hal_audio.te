# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_audio adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_audio adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_audio adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_audio bluetooth:binder { call transfer };
allow hal_audio bluetooth:binder { transfer };
allow hal_audio bluetooth:fd { use };
allow hal_audio firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_audio firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_audio hal_system_suspend_service:service_manager { find };
allow hal_audio hidl_manager_hwservice:hwservice_manager { find };
allow hal_audio hwservicemanager:binder { call transfer };
allow hal_audio hwservicemanager_prop:file { read getattr map open };
allow hal_audio init:unix_stream_socket { connectto };
allow hal_audio property_socket:sock_file { write };
allow hal_audio self:cap2_userns { block_suspend };
allow hal_audio self:capability2 { block_suspend };
allow hal_audio servicemanager:binder { call transfer };
allow hal_audio sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_audio system_suspend_hwservice:hwservice_manager { find };
allow hal_audio system_suspend_server:binder { call transfer };
allow hal_audio system_suspend_server:fd { use };
allow hal_audio vendor_adsp_sleepmon_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_audio vendor_adsprpc_prop:file { read getattr map open };
allow hal_audio vendor_audio_prop:file { read getattr map open };
allow hal_audio vendor_audio_ssr_prop:file { read getattr map open };
allow hal_audio vendor_audio_ssr_prop:property_service { set };
allow hal_audio vendor_audio_stub_prop:file { read getattr map open };
allow hal_audio vendor_audio_stub_prop:property_service { set };
allow hal_audio vendor_bluetooth_prop:file { read getattr map open };
allow hal_audio vendor_proc_audiod:file { ioctl read getattr lock map open watch watch_reads };
allow hal_audio vendor_sysfs_audio:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_audio vendor_sysfs_audio:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_audio vendor_sysfs_sndcard:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_audio vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_audio vndservicemanager:binder { call transfer };
