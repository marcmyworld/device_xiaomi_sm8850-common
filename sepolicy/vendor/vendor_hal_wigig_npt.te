# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_wigig_npt proc_net:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_wigig_npt self:capability { net_admin };
allow vendor_hal_wigig_npt sysfs_net:dir { search };
allow vendor_hal_wigig_npt vendor_hal_wigig_npt:unix_stream_socket { read write listen accept };
allow vendor_hal_wigig_npt vendor_sysfs_bond0:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_wigig_npt vendor_sysfs_wigig:file { ioctl read write getattr lock append map open watch watch_reads };
