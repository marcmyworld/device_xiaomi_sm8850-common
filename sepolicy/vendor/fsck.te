# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow fsck rescue_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow fsck vendor_persist_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow fsck vendor_qmcs_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow fsck vendor_spunvm_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allowxperm fsck vendor_qmcs_block_device:blk_file ioctl { 0x1260 };
allowxperm fsck vendor_spunvm_block_device:blk_file ioctl { 0x1260 };
