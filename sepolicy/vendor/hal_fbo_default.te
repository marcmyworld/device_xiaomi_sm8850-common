# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_fbo_default, domain, hal_fbo, hal_fbo_client, hal_fbo_server, halclientdomain, halserverdomain;
type hal_fbo_default_exec, exec_type, file_type, vendor_file_type;

allow hal_fbo_default block_device:dir { read getattr open search };
allow hal_fbo_default block_device:dir { search };
allow hal_fbo_default block_device:lnk_file { read };
allow hal_fbo_default boot_block_device:blk_file { read open };
allow hal_fbo_default build_prop:file { read getattr map open };
allow hal_fbo_default dm_device:blk_file { getattr };
allow hal_fbo_default gsort_block_device:blk_file { read write open };
allow hal_fbo_default gsort_block_device:lnk_file { read write open };
allow hal_fbo_default hal_fbo_default_exec:file { read getattr map execute open entrypoint };
allow hal_fbo_default init:unix_stream_socket { connectto };
allow hal_fbo_default proc_drop_caches:file { write lock append map open };
allow hal_fbo_default property_socket:sock_file { write };
allow hal_fbo_default self:netlink_kobject_uevent_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_fbo_default servicemanager:binder { call transfer };
allow hal_fbo_default snapshot_prop:file { read getattr map open };
allow hal_fbo_default snapshot_prop:property_service { set };
allow hal_fbo_default sysfs:dir { read getattr open search };
allow hal_fbo_default sysfs:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_fbo_default sysfs_devices_block:dir { search };
allow hal_fbo_default sysfs_devices_block:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_fbo_default sysfs_fs_f2fs:dir { read getattr open search };
allow hal_fbo_default sysfs_fs_f2fs:file { write getattr lock append map open };
allow hal_fbo_default sysfs_memory:dir { read getattr open search };
allow hal_fbo_default sysfs_memory:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_fbo_default system_data_file:dir { search };
allow hal_fbo_default system_server:binder { call };
allow hal_fbo_default vendor_fbo_prop:file { read getattr map open };
allow hal_fbo_default vendor_fbo_prop:property_service { set };
allow hal_fbo_default vendor_gpt_block_device:blk_file { read open };
allow hal_fbo_default vendor_security_patch_level_prop:file { read getattr map open };
allow hal_fbo_default vendor_xbl_block_device:blk_file { read open };
