# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute priv_app hal_mediaeventgatherservice_client;
typeattribute priv_app hal_videoservice_client;
typeattribute priv_app dvs_aidl_client;

allow priv_app hal_aidlbgservice_service:service_manager { find };
allow priv_app hal_mediaeventgatherservice:binder { call };
allow priv_app hal_mediaeventgatherservice_service:fd { use };
allow priv_app hal_mediaeventgatherservice_service:service_manager { find };
allow priv_app hal_ozonotify_service:service_manager { find };
allow priv_app hal_postprocservice_service:service_manager { find };
allow priv_app hal_quickcamera_service:service_manager { find };
allow priv_app perf_actuator_device:chr_file { ioctl read write open };
allow priv_app rs_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow priv_app servicemanager:binder { call transfer };
allow priv_app sound_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow priv_app vendor_audio_prop:file { read getattr map open };
allow priv_app vendor_camera_p3enable_prop:file { read getattr map open };
allow priv_app vendor_camera_xdrversion_prop:file { read getattr map open };
allow priv_app vendor_fp_prop:file { read getattr map open };
allow priv_app vendor_hal_displayfeature_xiaomi_default:binder { call };
allow priv_app vendor_hal_displayfeature_xiaomi_service:service_manager { find };
allow priv_app vendor_hal_fingerprint_service_xiaomi:service_manager { find };
allow priv_app vendor_mfp-daemon:binder { call transfer };
allow priv_app vendor_mfp-daemon:fd { use };
allow priv_app vendor_proximity_prop:file { read getattr map open };
allow priv_app vendor_uwb_prop:file { read getattr map open };
allow priv_app xr_fbt_device:chr_file { ioctl read write open };
allowxperm priv_app perf_actuator_device:chr_file ioctl { 0x7807 0x780b 0x781b };
allowxperm priv_app xr_fbt_device:chr_file ioctl { 0x7807 0x780b 0x781b };
