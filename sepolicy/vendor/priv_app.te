# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute priv_app hal_mediaeventgatherservice_client;
typeattribute priv_app_36 hal_mediaeventgatherservice_client;
typeattribute priv_app hal_videoservice_client;
typeattribute priv_app_36 hal_videoservice_client;
typeattribute priv_app dvs_aidl_client;
typeattribute priv_app_36 dvs_aidl_client;

allow priv_app_all hal_aidlbgservice_service:service_manager { find };
