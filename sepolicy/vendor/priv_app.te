allow priv_app_all perf_actuator_device:chr_file { ioctl read write open };
allow priv_app_all rs_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow priv_app_all servicemanager:binder { call transfer };
allow priv_app_all sound_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow priv_app_all vendor_audio_prop:file { read getattr map open };
allow priv_app_all vendor_camera_p3enable_prop:file { read getattr map open };
allow priv_app_all vendor_camera_xdrversion_prop:file { read getattr map open };
allow priv_app_all vendor_fp_prop:file { read getattr map open };
