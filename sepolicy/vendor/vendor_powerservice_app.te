# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_powerservice_app activity_service:service_manager { find };
allow vendor_powerservice_app app_api_service:service_manager { find };
allow vendor_powerservice_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_powerservice_app vendor_pasr_prop:file { read getattr map open };
allow vendor_powerservice_app vendor_powerservice_app_userfaultfd:anon_inode { ioctl read create };
allowxperm vendor_powerservice_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
