# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qteeconnector_qti hal_vsimapp_default:binder { transfer };
allow vendor_hal_qteeconnector_qti hal_vsimapp_default:fd { use };
allow vendor_hal_qteeconnector_qti hidl_base_hwservice:hwservice_manager { add };
allow vendor_hal_qteeconnector_qti tee:unix_dgram_socket { sendto };
allow vendor_hal_qteeconnector_qti tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_qteeconnector_qti vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_qteeconnector_qti vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_qteeconnector_qti vendor_hal_qteeconnector_hwservice:hwservice_manager { add find };
allow vendor_hal_qteeconnector_qti vendor_hal_qteeconnector_qti_exec:file { read getattr map execute open entrypoint };
