# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_vibrator input_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_vibrator input_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_vibrator sysfs_leds:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_vibrator sysfs_leds:file { ioctl read getattr lock map open watch watch_reads };
allow hal_vibrator sysfs_leds:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_vibrator vendor_soc_id_prop:file { read getattr map open };
