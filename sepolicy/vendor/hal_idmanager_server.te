# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_idmanager_server hal_idmanager_client:binder { transfer };
allow hal_idmanager_server hal_idmanager_service:service_manager { add find };
allow hal_idmanager_server servicemanager:binder { call transfer };
allow hal_idmanager_server servicemanager:fd { use };
