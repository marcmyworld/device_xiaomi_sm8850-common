# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_chre adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_chre adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_chre adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_chre ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_chre vendor_adsprpc_prop:file { read getattr map open };
allow vendor_chre vendor_chre_exec:file { read getattr map execute open entrypoint };
allow vendor_chre vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };
