# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow isolated_app perf_actuator_device:chr_file { ioctl read write open };
allow isolated_app xr_fbt_device:chr_file { ioctl read write open };
allowxperm isolated_app perf_actuator_device:chr_file ioctl { 0x7807 0x780b 0x781b };
allowxperm isolated_app xr_fbt_device:chr_file ioctl { 0x7807 0x780b 0x781b };
