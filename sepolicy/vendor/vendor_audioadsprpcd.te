# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_audioadsprpcd adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_audioadsprpcd adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd device:dir { read watch };
allow vendor_audioadsprpcd dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_audioadsprpcd sysfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_audioadsprpcd vendor_adsprpc_prop:file { read getattr map open };
allow vendor_audioadsprpcd vendor_audio_dsp_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_audioadsprpcd vendor_audio_dsp_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_audioadsprpcd_exec:file { read getattr map execute open entrypoint };
allow vendor_audioadsprpcd vendor_dmabuf_adsp_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_qdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_sysfs_public:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_audioadsprpcd vendor_sysfs_public:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_sysfs_public:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_audioadsprpcd vendor_xdsp_device:chr_file { ioctl read getattr lock map open watch watch_reads };
