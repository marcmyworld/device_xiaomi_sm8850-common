# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_authsecret_default hal_authsecret_default_exec:file { read getattr map execute open entrypoint };
allow hal_authsecret_default secure_element:binder { call transfer };
allow hal_authsecret_default secure_element:fd { use };
allow hal_authsecret_default secure_element_service:service_manager { find };
allow hal_authsecret_default self:capability2 { wake_alarm };
