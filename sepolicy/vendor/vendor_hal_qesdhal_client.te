# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_qesdhal_client vendor_hal_qesdhal_server:binder { call transfer };
allow vendor_hal_qesdhal_client vendor_hal_qesdhal_server:binder { transfer };
allow vendor_hal_qesdhal_client vendor_hal_qesdhal_server:fd { use };
allow vendor_hal_qesdhal_client vendor_hal_qesdhalaidl_service:service_manager { find };
allow vendor_hal_qesdhal_client vendor_hal_snapx_default:binder { transfer };
allow vendor_hal_qesdhal_client vendor_qesdsect:binder { transfer };
