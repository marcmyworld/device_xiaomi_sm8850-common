# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_displayfeature_xiaomi graphics_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_displayfeature_xiaomi graphics_device:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_displayfeature_xiaomi hal_graphics_composer:binder { call transfer };
allow vendor_hal_displayfeature_xiaomi hal_graphics_composer:fd { use };
allow vendor_hal_displayfeature_xiaomi vendor_displaylog_device:chr_file { ioctl read write open };
allow vendor_hal_displayfeature_xiaomi vendor_qdisplay_service:service_manager { find };
allow vendor_hal_displayfeature_xiaomi vendor_sysfs_graphics:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_hal_displayfeature_xiaomi vendor_sysfs_graphics:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_displayfeature_xiaomi vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_displayfeature_xiaomi vendor_sysfs_graphics:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_displayfeature_xiaomi vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_displayfeature_xiaomi vndservicemanager:binder { call transfer };
