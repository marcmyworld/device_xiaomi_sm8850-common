# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_msm_irqbalanced cgroup:dir { create add_name };
allow vendor_msm_irqbalanced proc:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_msm_irqbalanced proc:file { write lock append map open };
allow vendor_msm_irqbalanced proc_interrupts:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_msm_irqbalanced proc_stat:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_msm_irqbalanced sysfs_devices_system_cpu:file { write lock append map open };
allow vendor_msm_irqbalanced vendor_msm_irqbalanced_exec:file { read getattr map execute open entrypoint };
allow vendor_msm_irqbalanced vendor_sysfs_irqbalance:file { ioctl read getattr lock map open watch watch_reads };
