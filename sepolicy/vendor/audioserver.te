# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute audioserver hal_uniperf_client;
typeattribute audioserver hal_mediaeventgatherservice_client;

allow audioserver audio_prop:file { read getattr map open };
allow audioserver audio_prop:property_service { set };
allow audioserver bootanim:binder { call transfer };
allow audioserver bootanim:fd { use };
allow audioserver bootanim_system_prop:file { read getattr map open };
allow audioserver hal_audio_default:process { signal };
allow audioserver hal_mediaeventgatherservice:binder { call };
allow audioserver hal_mediaeventgatherservice_service:fd { use };
allow audioserver hal_mediaeventgatherservice_service:service_manager { find };
allow audioserver init:unix_stream_socket { connectto };
allow audioserver mediaserver:dir { search };
allow audioserver mediaserver:file { read open };
allow audioserver property_socket:sock_file { write };
allow audioserver servicemanager:binder { call transfer };
allow audioserver sound_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow audioserver system_app:dir { search };
allow audioserver system_server:dir { search };
allow audioserver vendor_audio_cloud_ctrl_mi_prop:file { read getattr map open };
allow audioserver vendor_audio_cloud_ctrl_mi_prop:property_service { set };
allow audioserver vendor_audio_prop:file { read getattr map open };
