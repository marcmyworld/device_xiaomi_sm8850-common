# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow netutils_wrapper minetd:fd { use };
allow netutils_wrapper minetd:fifo_file { write };
allow netutils_wrapper minetd:unix_stream_socket { read write };
allow netutils_wrapper netutils_wrapper_exec:file { read getattr map execute open entrypoint };
allow netutils_wrapper slad:fd { use };
allow netutils_wrapper slad:fifo_file { write };
allow netutils_wrapper slad:rawip_socket { read write };
allow netutils_wrapper slad:tcp_socket { read write };
allow netutils_wrapper slad:unix_stream_socket { read write };
allow netutils_wrapper vendor_dpmd:fd { use };
allow netutils_wrapper vendor_dpmd:fifo_file { read write getattr };
allow netutils_wrapper vendor_dpmd:netlink_generic_socket { read write };
allow netutils_wrapper vendor_dpmd:netlink_route_socket { read write };
allow netutils_wrapper vendor_dpmd:netlink_xfrm_socket { read write };
allow netutils_wrapper vendor_dpmd:process { sigchld };
allow netutils_wrapper vendor_dpmd:tcp_socket { read write };
allow netutils_wrapper vendor_dpmd:udp_socket { read write };
allow netutils_wrapper vendor_dpmd:unix_dgram_socket { read write };
allow netutils_wrapper vendor_dpmd:unix_stream_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:fd { use };
allow netutils_wrapper vendor_dpmd_vndr:fifo_file { read write getattr };
allow netutils_wrapper vendor_dpmd_vndr:netlink_generic_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:netlink_route_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:netlink_xfrm_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:process { sigchld };
allow netutils_wrapper vendor_dpmd_vndr:tcp_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:udp_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:unix_dgram_socket { read write };
allow netutils_wrapper vendor_dpmd_vndr:unix_stream_socket { read write };
allow netutils_wrapper vendor_nicmd:fd { use };
allow netutils_wrapper vendor_nicmd:fifo_file { read write getattr };
allow netutils_wrapper vendor_nicmd:netlink_generic_socket { read write };
allow netutils_wrapper vendor_nicmd:netlink_route_socket { read write };
allow netutils_wrapper vendor_nicmd:netlink_xfrm_socket { read write };
allow netutils_wrapper vendor_nicmd:process { sigchld };
allow netutils_wrapper vendor_nicmd:tcp_socket { read write };
allow netutils_wrapper vendor_nicmd:udp_socket { read write };
allow netutils_wrapper vendor_nicmd:unix_dgram_socket { read write };
allow netutils_wrapper vendor_nicmd:unix_stream_socket { read write };
allow netutils_wrapper vendor_qms:fd { use };
allow netutils_wrapper vendor_qms:fifo_file { read write getattr };
allow netutils_wrapper vendor_qms:netlink_generic_socket { read write };
allow netutils_wrapper vendor_qms:netlink_route_socket { read write };
allow netutils_wrapper vendor_qms:netlink_xfrm_socket { read write };
allow netutils_wrapper vendor_qms:process { sigchld };
allow netutils_wrapper vendor_qms:tcp_socket { read write };
allow netutils_wrapper vendor_qms:udp_socket { read write };
allow netutils_wrapper vendor_qms:unix_dgram_socket { read write };
allow netutils_wrapper vendor_qms:unix_stream_socket { read write };
allow netutils_wrapper vendor_shsusrd:fd { use };
allow netutils_wrapper vendor_shsusrd:fifo_file { read write getattr };
allow netutils_wrapper vendor_shsusrd:netlink_generic_socket { read write };
allow netutils_wrapper vendor_shsusrd:netlink_route_socket { read write };
allow netutils_wrapper vendor_shsusrd:netlink_xfrm_socket { read write };
allow netutils_wrapper vendor_shsusrd:process { sigchld };
allow netutils_wrapper vendor_shsusrd:tcp_socket { read write };
allow netutils_wrapper vendor_shsusrd:udp_socket { read write };
allow netutils_wrapper vendor_shsusrd:unix_dgram_socket { read write };
