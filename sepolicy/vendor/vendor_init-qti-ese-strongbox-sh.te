# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_init-qti-ese-strongbox-sh init:unix_stream_socket { connectto };
allow vendor_init-qti-ese-strongbox-sh nfc_device:chr_file { getattr map open };
allow vendor_init-qti-ese-strongbox-sh property_socket:sock_file { write };
allow vendor_init-qti-ese-strongbox-sh vendor_ese_gpio_device:chr_file { getattr map open };
allow vendor_init-qti-ese-strongbox-sh vendor_ese_gpio_proc:file { read getattr open };
allow vendor_init-qti-ese-strongbox-sh vendor_ese_strongbox_prop:file { read getattr map open };
allow vendor_init-qti-ese-strongbox-sh vendor_ese_strongbox_prop:property_service { set };
allow vendor_init-qti-ese-strongbox-sh vendor_init-qti-ese-strongbox-sh_exec:file { read getattr map execute open entrypoint };
allow vendor_init-qti-ese-strongbox-sh vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_init-qti-ese-strongbox-sh vendor_sysfs_devicetree_soc:dir { search };
allow vendor_init-qti-ese-strongbox-sh vendor_sysfs_devicetree_soc:file { read getattr open };
allow vendor_init-qti-ese-strongbox-sh vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
