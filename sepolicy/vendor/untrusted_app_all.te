# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow untrusted_app_all hal_ozonotify:binder { call transfer };
allow untrusted_app_all hal_ozonotify:binder { transfer };
allow untrusted_app_all hal_ozonotify:fd { use };
allow untrusted_app_all hal_ozonotify_hwservice:hwservice_manager { find };
allow untrusted_app_all hal_ozonotify_service:service_manager { find };
allow untrusted_app_all perf_actuator_device:chr_file { ioctl read write open };
allow untrusted_app_all vendor_audio_prop:file { read getattr map open };
allow untrusted_app_all vendor_sysfs_esoc:dir { search };
allow untrusted_app_all vendor_sysfs_soc:dir { search };
allow untrusted_app_all vendor_sysfs_ssr:dir { search };
allow untrusted_app_all xr_fbt_device:chr_file { ioctl read write open };
allowxperm untrusted_app_all perf_actuator_device:chr_file ioctl { 0x7807 0x780b 0x781b };
allowxperm untrusted_app_all xr_fbt_device:chr_file ioctl { 0x7807 0x780b 0x781b };
