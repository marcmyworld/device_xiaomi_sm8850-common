# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_dumpstate_impl, domain, hal_dumpstate, hal_dumpstate_server, hal_misys_vendor_client, halclientdomain, halserverdomain;
type hal_dumpstate_impl_exec, exec_type, file_type, vendor_file_type;

allow hal_dumpstate_impl device:dir { search };
allow hal_dumpstate_impl dumpstate:fifo_file { write getattr };
allow hal_dumpstate_impl hal_dumpstate_impl_exec:file { read getattr map execute open entrypoint };
allow hal_dumpstate_impl init:unix_stream_socket { connectto };
allow hal_dumpstate_impl property_socket:sock_file { write };
allow hal_dumpstate_impl shell_data_file:file { getattr };
allow hal_dumpstate_impl sysfs:dir { search };
allow hal_dumpstate_impl sysfs_memory:dir { read open search };
allow hal_dumpstate_impl sysfs_memory:file { read open };
allow hal_dumpstate_impl ufs_utils_exec:file { execute_no_trans };
allow hal_dumpstate_impl vendor_bsg_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_dumpstate_impl vendor_bsp_data_log_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_dumpstate_impl vendor_bsp_data_log_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_dumpstate_impl vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_dumpstate_impl vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_dumpstate_impl vendor_dumpstate_prop:file { read getattr map open };
allow hal_dumpstate_impl vendor_dumpstate_prop:property_service { set };
allow hal_dumpstate_impl vendor_persist_stability:file { read getattr map open };
allow hal_dumpstate_impl vendor_proc_perflock_exception:file { ioctl read getattr lock map open watch watch_reads };
allow hal_dumpstate_impl vendor_proc_perflock_records:file { ioctl read getattr lock map open watch watch_reads };
allow hal_dumpstate_impl vendor_sensors_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_dumpstate_impl vendor_sensors_vendor_data_file:fifo_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_dumpstate_impl vendor_sensors_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_dumpstate_impl vendor_shell_exec:file { execute_no_trans };
allow hal_dumpstate_impl vendor_stability_prop:file { read getattr map open };
allow hal_dumpstate_impl vendor_sysfs_xm_power:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_dumpstate_impl vendor_sysfs_xm_power:file { read write open };
allow hal_dumpstate_impl vendor_system_prop:file { read getattr map open };
allow hal_dumpstate_impl vendor_toolbox_exec:file { execute_no_trans };
allow hal_dumpstate_impl vendor_ufs_lun4_bsg_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_dumpstate_impl vfat:dir { getattr search };
allow hal_dumpstate_impl vfat:file { read getattr setattr open };
