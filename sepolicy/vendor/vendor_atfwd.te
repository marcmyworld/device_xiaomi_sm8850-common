# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_atfwd anr_data_file:file { append };
allow vendor_atfwd dumpstate:fd { use };
allow vendor_atfwd dumpstate:fifo_file { write append };
allow vendor_atfwd hwservicemanager:binder { call transfer };
allow vendor_atfwd hwservicemanager_prop:file { read getattr map open };
allow vendor_atfwd incidentd:fd { use };
allow vendor_atfwd incidentd:fifo_file { write append };
allow vendor_atfwd init:unix_stream_socket { connectto };
allow vendor_atfwd property_socket:sock_file { write };
allow vendor_atfwd radio:binder { call transfer };
allow vendor_atfwd radio:fd { use };
allow vendor_atfwd radio_service:service_manager { find };
allow vendor_atfwd self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_atfwd self:socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_atfwd servicemanager:binder { call transfer };
allow vendor_atfwd system_app:binder { call transfer };
allow vendor_atfwd system_app:fd { use };
allow vendor_atfwd system_server:fifo_file { write append };
allow vendor_atfwd tombstone_data_file:file { append };
allow vendor_atfwd tombstoned:fd { use };
allow vendor_atfwd tombstoned:unix_stream_socket { connectto };
allow vendor_atfwd tombstoned_crash_socket:sock_file { write };
allow vendor_atfwd vendor_atfwd_exec:file { read getattr map execute open entrypoint };
allow vendor_atfwd vendor_hal_atfwd_hwservice:hwservice_manager { find };
allow vendor_atfwd vendor_qtelephony:binder { call transfer };
allow vendor_atfwd vendor_qtelephony:fd { use };
allow vendor_atfwd vendor_radio_prop:file { read getattr map open };
allow vendor_atfwd vendor_radio_prop:property_service { set };
allow vendor_atfwd vendor_sysfs_data:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_atfwd vendor_sysfs_data:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_atfwd vendor_sysfs_data:lnk_file { ioctl read getattr lock map open watch watch_reads };
allowxperm vendor_atfwd self:socket ioctl { 0xc300-0xc305 };
