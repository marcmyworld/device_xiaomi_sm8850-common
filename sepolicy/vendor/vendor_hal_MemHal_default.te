# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_MemHal_default appdomain:process { getpgid };
allow vendor_hal_MemHal_default appdomain:process { sigkill };
allow vendor_hal_MemHal_default proc_meminfo:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_hal_MemHal_default self:capability { kill };
allow vendor_hal_MemHal_default self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_hal_MemHal_default vendor_hal_MemHal_default_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_MemHal_default vendor_lm_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_hal_MemHal_default vendor_lm_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_hal_MemHal_default vendor_mpctl_prop:file { read getattr map open };
