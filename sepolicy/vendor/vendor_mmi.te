# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_mmi mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mmi proc:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mmi self:capability { fowner fsetid kill };
allow vendor_mmi self:socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_mmi self:udp_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_mmi socket_device:dir { write lock open add_name remove_name search };
allow vendor_mmi sysfs_devices_system_cpu:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi sysfs_power:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi vendor_audioftm:process { siginh rlimitinh };
allow vendor_mmi vendor_audioftm:process { transition };
allow vendor_mmi vendor_audioftm_exec:file { read getattr map execute open };
allow vendor_mmi vendor_cnd:unix_stream_socket { connectto };
allow vendor_mmi vendor_cnd_socket:sock_file { write };
allow vendor_mmi vendor_mmi_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_mmi vendor_mmi_exec:file { read getattr map execute open entrypoint };
allow vendor_mmi vendor_mmi_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_mmi vendor_sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi vendor_sysfs_graphics:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi vendor_sysfs_soc:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_mmi vendor_sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
dontaudit vendor_mmi vendor_audioftm:process { noatsecure };
