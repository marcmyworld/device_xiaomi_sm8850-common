# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_vui_dmgr anr_data_file:file { append };
allow vendor_vui_dmgr dumpstate:fd { use };
allow vendor_vui_dmgr dumpstate:fifo_file { write append };
allow vendor_vui_dmgr incidentd:fd { use };
allow vendor_vui_dmgr incidentd:fifo_file { write append };
allow vendor_vui_dmgr system_server:fifo_file { write append };
allow vendor_vui_dmgr tombstone_data_file:file { append };
allow vendor_vui_dmgr tombstoned:fd { use };
allow vendor_vui_dmgr tombstoned:unix_stream_socket { connectto };
allow vendor_vui_dmgr tombstoned_crash_socket:sock_file { write };
allow vendor_vui_dmgr vendor_audio_dsp_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_vui_dmgr vendor_audio_dsp_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_vui_dmgr vendor_hal_qesdhal:unix_stream_socket { connectto };
allow vendor_vui_dmgr vendor_qesd_socket:sock_file { write };
allow vendor_vui_dmgr vendor_vui_dmgr_exec:file { read getattr map execute open entrypoint };
allow vendor_vui_dmgr vendor_vuidmgr_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
