# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_gnss_default gnss_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_gnss_default hal_gnss_default_exec:file { read getattr map execute open entrypoint };
