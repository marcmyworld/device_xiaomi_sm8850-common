# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_mmi_sys vendor_sysfs_graphics:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_mmi_sys vendor_sysfs_graphics:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_mmi_sys vendor_sysfs_graphics:lnk_file { ioctl read getattr lock map open watch watch_reads };
