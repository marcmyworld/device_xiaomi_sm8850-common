# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_graphics_composer_server hidl_base_hwservice:hwservice_manager { add };
allow hal_graphics_composer_server vendor_hal_display_config_hwservice:hwservice_manager { add find };
allow hal_graphics_composer_server vendor_hal_displayconfig_service:service_manager { add find };
allow hal_graphics_composer_server vendor_hal_hwcextension_xiaomi_service:service_manager { add find };
allow hal_graphics_composer_server vendor_hal_vnddisplayconfig_service:service_manager { add find };
