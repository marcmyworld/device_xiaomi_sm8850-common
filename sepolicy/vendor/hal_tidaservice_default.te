# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_tidaservice_default, domain, hal_mtdservice_client, hal_tidaservice, hal_tidaservice_server, halclientdomain, halserverdomain;
type hal_tidaservice_default_exec, exec_type, file_type, vendor_file_type;

allow hal_tidaservice_default firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_tidaservice_default firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_tidaservice_default hal_mtdservice_default:binder { call transfer };
allow hal_tidaservice_default hal_mtdservice_default:fd { use };
allow hal_tidaservice_default hal_tidaservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_tidaservice_default ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_tidaservice_default rootfs:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_tidaservice_default servicemanager:binder { call transfer };
allow hal_tidaservice_default sysfs:dir { read open };
allow hal_tidaservice_default sysfs:file { read write open };
allow hal_tidaservice_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_tidaservice_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read open };
allow hal_tidaservice_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read open };
allow hal_tidaservice_default vendor_fp_prop:file { read getattr map open };
allow hal_tidaservice_default vendor_payment_security_prop:file { read getattr map open };
allow hal_tidaservice_default vendor_system_prop:file { read getattr map open };
