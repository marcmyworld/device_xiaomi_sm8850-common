# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_hwcrypto_client hal_hwcrypto_server:binder { call transfer };
allow hal_hwcrypto_client hal_hwcrypto_server:fd { use };
allow hal_hwcrypto_client hal_hwcrypto_service:service_manager { find };
