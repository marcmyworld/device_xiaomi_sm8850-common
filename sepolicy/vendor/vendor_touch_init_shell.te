# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, file_type, vendor_file_type;

allow vendor_touch_init_shell init:unix_stream_socket { connectto };
allow vendor_touch_init_shell kernel:system { syslog_read };
allow vendor_touch_init_shell kmsg_device:chr_file { read open };
allow vendor_touch_init_shell property_socket:sock_file { write };
allow vendor_touch_init_shell sysfs:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_touch_init_shell vendor_data_touchreport_file:dir { read write create getattr watch add_name remove_name search };
allow vendor_touch_init_shell vendor_data_touchreport_file:file { read write create getattr setattr append unlink rename open };
allow vendor_touch_init_shell vendor_panel_info_prop:file { read getattr map open };
allow vendor_touch_init_shell vendor_panel_info_prop:property_service { set };
allow vendor_touch_init_shell vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans entrypoint };
allow vendor_touch_init_shell vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow vendor_touch_init_shell vendor_touch_init_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans entrypoint };
allow vendor_touch_init_shell vendor_touch_init_shell_exec:file { read getattr map execute open entrypoint };
allow vendor_touch_init_shell vendor_touchfeature_prop:file { read getattr map open };
allow vendor_touch_init_shell vendor_touchfeature_prop:property_service { set };
