# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qsap_location anr_data_file:file { append };
allow vendor_qsap_location dumpstate:fd { use };
allow vendor_qsap_location dumpstate:fifo_file { write append };
allow vendor_qsap_location incidentd:fd { use };
allow vendor_qsap_location incidentd:fifo_file { write append };
allow vendor_qsap_location system_server:fifo_file { write append };
allow vendor_qsap_location tombstone_data_file:file { append };
allow vendor_qsap_location tombstoned:fd { use };
allow vendor_qsap_location tombstoned:unix_stream_socket { connectto };
allow vendor_qsap_location tombstoned_crash_socket:sock_file { write };
allow vendor_qsap_location vendor_hal_gnss_qti:unix_dgram_socket { sendto };
allow vendor_qsap_location vendor_hal_qesdhal:unix_stream_socket { connectto };
allow vendor_qsap_location vendor_location_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_qsap_location vendor_location_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_qsap_location vendor_qesd_socket:sock_file { write };
allow vendor_qsap_location vendor_qsap_location_exec:file { read getattr map execute open entrypoint };
allow vendor_qsap_location vendor_qsap_location_socket:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_qsap_location vendor_qsap_location_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
