# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_perfdump_app app_api_service:service_manager { find };
allow vendor_perfdump_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_perfdump_app audioserver_service:service_manager { find };
allow vendor_perfdump_app debug_prop:file { read getattr map open };
allow vendor_perfdump_app debug_prop:property_service { set };
allow vendor_perfdump_app dumpstate:unix_stream_socket { connectto };
allow vendor_perfdump_app dumpstate_socket:sock_file { write };
allow vendor_perfdump_app hwservicemanager:hwservice_manager { list };
allow vendor_perfdump_app init:unix_stream_socket { connectto };
allow vendor_perfdump_app mediaserver_service:service_manager { find };
allow vendor_perfdump_app property_socket:sock_file { write };
allow vendor_perfdump_app servicemanager:binder { call transfer };
allow vendor_perfdump_app servicemanager:service_manager { list };
allow vendor_perfdump_app surfaceflinger_service:service_manager { find };
allow vendor_perfdump_app system_app_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_perfdump_app system_app_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_perfdump_app system_server:binder { call transfer };
allow vendor_perfdump_app system_server:fd { use };
allow vendor_perfdump_app vendor_perfdump_app_userfaultfd:anon_inode { ioctl read create };
allowxperm vendor_perfdump_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
dontaudit vendor_perfdump_app hwservice_manager_type:hwservice_manager { add find list };
dontaudit vendor_perfdump_app service_manager_type:service_manager { add find list };
