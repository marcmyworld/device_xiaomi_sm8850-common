allow vendor_hal_misensor_camera_default hal_graphics_mapper_hwservice:hwservice_manager { find };
allow vendor_hal_misensor_camera_default hidl_token_hwservice:hwservice_manager { find };
allow vendor_hal_misensor_camera_default self:qipcrtr_socket { ioctl read write create getattr setattr lock append map bind connect getopt setopt shutdown };
