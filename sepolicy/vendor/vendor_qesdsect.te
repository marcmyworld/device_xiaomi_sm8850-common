# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qesdsect anr_data_file:file { append };
allow vendor_qesdsect boot_status_prop:file { read getattr map open };
allow vendor_qesdsect dumpstate:fd { use };
allow vendor_qesdsect dumpstate:fifo_file { write append };
allow vendor_qesdsect incidentd:fd { use };
allow vendor_qesdsect incidentd:fifo_file { write append };
allow vendor_qesdsect servicemanager:binder { call transfer };
allow vendor_qesdsect system_server:fifo_file { write append };
allow vendor_qesdsect tombstone_data_file:file { append };
allow vendor_qesdsect tombstoned:fd { use };
allow vendor_qesdsect tombstoned:unix_stream_socket { connectto };
allow vendor_qesdsect tombstoned_crash_socket:sock_file { write };
allow vendor_qesdsect vendor_hal_qesdhal_client:binder { call transfer };
allow vendor_qesdsect vendor_hal_qesdhal_client:fd { use };
allow vendor_qesdsect vendor_hlosminkdaemon:unix_stream_socket { connectto };
allow vendor_qesdsect vendor_qesdk_service:service_manager { find };
allow vendor_qesdsect vendor_qesdsect_exec:file { read getattr map execute open entrypoint };
allow vendor_qesdsect vendor_ssgtzd:unix_stream_socket { connectto };
allow vendor_qesdsect vendor_ssgtzd_socket:sock_file { write };
