# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_cvp adsprpcd_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_cvp adsprpcd_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_cvp adsprpcd_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_cvp ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_cvp vendor_cvp_exec:file { read getattr map execute open entrypoint };
allow vendor_cvp video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
