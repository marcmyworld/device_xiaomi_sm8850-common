# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_wifidisplayhalservice_server hal_wifidisplayaudio_service:service_manager { add find };
allow vendor_wifidisplayhalservice_server hal_wifidisplayimage_service:service_manager { add find };
allow vendor_wifidisplayhalservice_server hal_wifidisplaysession_service:service_manager { add find };
allow vendor_wifidisplayhalservice_server hal_wifidisplayvideo_service:service_manager { add find };
allow vendor_wifidisplayhalservice_server vendor_wifidisplayhalservice_client:binder { call transfer };
allow vendor_wifidisplayhalservice_server vendor_wifidisplayhalservice_client:binder { transfer };
allow vendor_wifidisplayhalservice_server vendor_wifidisplayhalservice_client:fd { use };
