# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_syshealthmon self:qipcrtr_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow vendor_syshealthmon vendor_sysfs_rproc_state:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_syshealthmon vendor_sysfs_ssr:file { ioctl read getattr lock map open watch watch_reads };
