# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_secretkeeper_qti tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_hal_secretkeeper_qti vendor_hal_secretkeeper_qti_exec:file { read getattr map execute open entrypoint };
allow vendor_hal_secretkeeper_qti vendor_tee_listener_prop:file { read getattr map open };
dontaudit vendor_hal_secretkeeper_qti firmware_file:dir { search };
