# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

type hal_cit_wifi_default, domain, hal_cit_wifi, hal_cit_wifi_server, halserverdomain;
type hal_cit_wifi_default_exec, exec_type, file_type, vendor_file_type;

allow hal_cit_wifi_default hal_cit_wifi_default_exec:file { read getattr map execute open entrypoint };
allow hal_cit_wifi_default hal_cit_wifi_service:service_manager { add };
allow hal_cit_wifi_default hal_cit_wifi_sub:process { siginh rlimitinh };
allow hal_cit_wifi_default hal_cit_wifi_sub:process { transition };
allow hal_cit_wifi_default servicemanager:binder { call transfer };
allow hal_cit_wifi_default sysfs:file { read write open };
allow hal_cit_wifi_default sysfs_net:file { read write open };
allow hal_cit_wifi_default vendor_cit_wifi_prop:file { read getattr map open };
allow hal_cit_wifi_default vendor_shell_exec:file { read getattr map execute open };
allow hal_cit_wifi_default vendor_wlan_chip_prop:file { read getattr map open };
dontaudit hal_cit_wifi_default hal_cit_wifi_sub:process { noatsecure };
type_transition hal_cit_wifi_default vendor_shell_exec:process hal_cit_wifi_sub;
