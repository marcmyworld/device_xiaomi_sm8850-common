# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_syshealthmon_client vendor_syshealthmon_server:binder { call transfer };
allow vendor_syshealthmon_client vendor_syshealthmon_server:binder { transfer };
allow vendor_syshealthmon_client vendor_syshealthmon_server:fd { use };
allow vendor_syshealthmon_client vendor_syshealthmon_service:service_manager { find };
