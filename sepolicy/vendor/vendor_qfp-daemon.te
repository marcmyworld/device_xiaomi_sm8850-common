# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_qfp-daemon firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qfp-daemon firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon init:unix_stream_socket { connectto };
allow vendor_qfp-daemon mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qfp-daemon mnt_vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon mnt_vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon property_socket:sock_file { write };
allow vendor_qfp-daemon self:capability2 { wake_alarm block_suspend };
allow vendor_qfp-daemon tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qfp-daemon vendor_dmabuf_qseecom_heap_device:chr_file { ioctl read write open };
allow vendor_qfp-daemon vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl read write open };
allow vendor_qfp-daemon vendor_persist_qti_fp_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qfp-daemon vendor_persist_qti_fp_file:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon vendor_persist_qti_fp_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_qfp-daemon vendor_qbt_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qfp-daemon vendor_qfp-daemon_data_file:dir { ioctl read write getattr setattr lock open watch watch_reads add_name remove_name search };
allow vendor_qfp-daemon vendor_qfp-daemon_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_qfp-daemon vendor_qfp-daemon_exec:file { read getattr map execute open entrypoint };
allow vendor_qfp-daemon vendor_sysfs_touch_aoi:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_qfp-daemon vendor_sysfs_touch_aoi:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_qfp-daemon vndbinder_device:chr_file { ioctl read write map open };
