# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_displayfeature_xiaomi_client vendor_hal_displayfeature_xiaomi_server:binder { call transfer };
allow vendor_hal_displayfeature_xiaomi_client vendor_hal_displayfeature_xiaomi_server:fd { use };
allow vendor_hal_displayfeature_xiaomi_client vendor_hal_displayfeature_xiaomi_service:service_manager { find };
allow vendor_hal_displayfeature_xiaomi_client vendor_hal_framecapturemanager_xiaomi_service:service_manager { find };
allow vendor_hal_displayfeature_xiaomi_client vendor_hal_framemaster_xiaomi_service:service_manager { find };
