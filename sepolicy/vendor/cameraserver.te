# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute cameraserver hal_misys_vendor_client;

allow cameraserver aidlintentaware_service:service_manager { find };
allow cameraserver device:dir { ioctl read getattr lock open watch watch_reads search };
allow cameraserver gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow cameraserver hal_external_camera_service:service_manager { find };
allow cameraserver hal_miface_default:binder { transfer };
allow cameraserver hal_miface_default:dir { search };
allow cameraserver hal_miface_default:file { read getattr map open };
allow cameraserver hal_misecmedia_default:binder { call };
allow cameraserver hal_misecmedia_default:binder { transfer };
allow cameraserver hal_misecmedia_default:dir { search };
allow cameraserver hal_misecmedia_default:file { ioctl read write getattr lock append map open watch watch_reads };
allow cameraserver hal_misys_vendor_server:binder { call transfer };
allow cameraserver hal_misys_vendor_server:fd { use };
allow cameraserver hal_misys_vendor_service:service_manager { find };
allow cameraserver hal_mivimessage_service:service_manager { find };
allow cameraserver hal_mseccam_default:binder { call };
allow cameraserver hal_mseccam_default:binder { transfer };
allow cameraserver hal_mseccam_default:dir { search };
allow cameraserver hal_mseccam_default:file { ioctl read write getattr lock append map open watch watch_reads };
allow cameraserver mediacodec:binder { call transfer };
allow cameraserver mediacodec:fd { use };
allow cameraserver self:capability { fowner };
allow cameraserver servicemanager:binder { call transfer };
allow cameraserver system_file:dir { ioctl read getattr lock open watch watch_reads search };
allow cameraserver system_server:unix_stream_socket { read write };
allow cameraserver vendor_adsprpc_prop:file { read getattr map open };
allow cameraserver vendor_camera_mi_prop:file { read getattr map open };
allow cameraserver vendor_camera_prop:file { read getattr map open };
allow cameraserver vendor_display_prop:file { read getattr map open };
allow cameraserver vendor_hal_misensor_camera_default:binder { call transfer };
allow cameraserver vendor_hal_misensor_camera_default:binder { transfer };
allow cameraserver vendor_hal_misensor_camera_default:dir { search };
allow cameraserver vendor_hal_misensor_camera_default:fd { use };
allow cameraserver vendor_hal_misensor_camera_default:file { read getattr open };
allow cameraserver vendor_hal_perf_default:binder { call };
allow cameraserver vendor_hal_perf_hwservice:hwservice_manager { find };
allow cameraserver vendor_sysfs_camera:dir { search };
allow cameraserver vendor_sysfs_camera:file { ioctl read getattr lock map open watch watch_reads };
allow cameraserver video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow cameraserver video_device:dir { ioctl read getattr lock open watch watch_reads search };
