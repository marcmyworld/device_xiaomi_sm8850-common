# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow tee block_device:dir { getattr search };
allow tee device:dir { ioctl read getattr lock open watch watch_reads search };
allow tee firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow tee firmware_file:dir { search };
allow tee firmware_file:file { ioctl read getattr lock map open watch watch_reads };
