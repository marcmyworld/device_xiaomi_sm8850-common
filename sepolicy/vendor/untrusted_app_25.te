# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

typeattribute untrusted_app_25 hal_videoservice_client;
typeattribute untrusted_app_25 dvs_aidl_client;

allow untrusted_app_25 vendor_sysfs_kgsl_gpuclk:file { ioctl read getattr lock map open watch watch_reads };
