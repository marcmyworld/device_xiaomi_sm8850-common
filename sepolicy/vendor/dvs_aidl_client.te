# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow dvs_aidl_client dvs_aidl_server:binder { call transfer };
allow dvs_aidl_client dvs_aidl_server:binder { transfer };
allow dvs_aidl_client dvs_aidl_server:fd { use };
allow dvs_aidl_client dvs_aidl_service:service_manager { find };
