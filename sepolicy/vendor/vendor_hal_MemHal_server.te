# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_hal_MemHal_server servicemanager:binder { call transfer };
allow vendor_hal_MemHal_server servicemanager:fd { use };
allow vendor_hal_MemHal_server vendor_hal_MemHal_client:binder { transfer };
allow vendor_hal_MemHal_server vendor_hal_MemHal_service:service_manager { add find };
