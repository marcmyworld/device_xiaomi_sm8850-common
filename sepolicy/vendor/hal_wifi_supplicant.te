# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_wifi_supplicant vendor_fstman:unix_dgram_socket { sendto };
allow hal_wifi_supplicant vendor_wifi_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_wifi_supplicant vendor_wifi_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_supplicant vendor_wifi_vendor_wpa_socket:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_wifi_supplicant vendor_wifi_vendor_wpa_socket:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_supplicant vendor_wigig_vendor_wpa_socket:sock_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_wifi_supplicant vendor_wigighalsvc:unix_dgram_socket { sendto };
