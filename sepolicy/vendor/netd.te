# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow netd slad:fd { use };
allow netd slad:udp_socket { read write getopt setopt };
allow netd slad:unix_stream_socket { read write getattr };
allow netd slad_socket:sock_file { read write getattr };
allow netd vendor_nicmd:binder { transfer };
dontaudit netd kernel:system { module_request };
dontaudit netd self:capability { sys_module };
