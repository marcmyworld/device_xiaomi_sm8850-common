# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_evs_default automotive_display_service_server:binder { call transfer };
allow hal_evs_default automotive_display_service_server:fd { use };
allow hal_evs_default device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_evs_default fwk_automotive_display_hwservice:hwservice_manager { find };
allow hal_evs_default fwk_automotive_display_service:service_manager { find };
allow hal_evs_default gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_evs_default gpu_device:dir { search };
allow hal_evs_default graphics_config_prop:file { read getattr map open };
allow hal_evs_default graphics_config_writable_prop:file { read getattr map open };
allow hal_evs_default hal_evs_default_exec:file { read getattr map execute open entrypoint };
allow hal_evs_default hidl_token_hwservice:hwservice_manager { find };
allow hal_evs_default servicemanager:binder { call transfer };
allow hal_evs_default surfaceflinger:fd { use };
allow hal_evs_default video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
