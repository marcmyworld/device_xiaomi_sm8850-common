# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow hal_micharge_server hal_micharge_client:binder { call transfer };
allow hal_micharge_server hal_micharge_client:binder { transfer };
allow hal_micharge_server hal_micharge_client:fd { use };
allow hal_micharge_server hal_micharge_service:service_manager { add find };
