# Derived from the stock vendor SELinux policy (HyperOS OS3.0.335.0.XPCEUXM),
# limited to what the shipped blobs need. Generated by tools; keep edits minimal.

allow vendor_battery_stats vendor_battery_stats_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_battery_stats vendor_battery_stats_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_battery_stats vendor_battery_stats_exec:file { read getattr map execute open entrypoint };
allow vendor_battery_stats vendor_qccvendor:binder { call transfer };
allow vendor_battery_stats vendor_qccvendor:binder { transfer };
allow vendor_battery_stats vendor_qccvendor:fd { use };
allow vendor_battery_stats vendor_qtrsdkservice_service:service_manager { find };
allow vendor_battery_stats vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_battery_stats vendor_sysfs_battery_supply:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_battery_stats vendor_sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_battery_stats vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_battery_stats vendor_sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow vendor_battery_stats vendor_sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow vendor_battery_stats vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_battery_stats vndservicemanager:binder { call transfer };
