    <string name="haptics_waveform_guide_title">Visual waveform guide</string>
    <string name="haptics_waveform_guide_summary">Illustrated breakdown of each waveform type with tap-to-feel preview</string>
    <string name="haptics_waveform_guide_hint">Tap any card below to feel that waveform live with your current tuning</string>
    <string name="haptics_waveform_picker_hint">Select a firmware waveform below to feel it immediately</string>
    <string name="haptics_desc_click">Crisp single impact for button taps, launcher clicks, and keyboard key presses.</string>
    <string name="haptics_desc_tick">Light upper transient played on key releases, micro selections, and switch detents.</string>
    <string name="haptics_desc_heavy">Deep low-frequency thump used for long-press actions, back commit, and heavy confirmations.</string>
    <string name="haptics_desc_slider">Fine low-amplitude grain repeated smoothly while dragging sliders or scrolling lists.</string>
    <string name="haptics_desc_quick_rise">Fast ascending swell that builds tactile tension during back-swipe pulls and edge triggers.</string>
    <string name="haptics_desc_quick_fall">Clean downward drop that settles quickly without harsh bounce when gestures or toggles release.</string>
    <string name="haptics_desc_slow_rise">Gradual prolonged crescendo used during long holds, zoom swells, and progressive animations.</string>
    <string name="haptics_desc_spin">Repeating rotary pulse pattern tailored for orbital dials, spinners, and radial scrubbers.</string>

