    <string name="haptics_profile_balanced_title">Breeze</string>
    <string name="haptics_profile_balanced_summary">Calm, soothing 85–105 Hz low-frequency response with smooth key releases and gentle slider ticks</string>
    <string name="haptics_profile_crisp_tight_title">Subtle</string>
    <string name="haptics_profile_crisp_tight_summary">Damped 144 Hz resonant clicks with restrained tail and light, unobtrusive feedback</string>
    <string name="haptics_profile_thin_light_title">Feather</string>
    <string name="haptics_profile_thin_light_summary">Airy, whisper-light micro-transients with half-peak amplitude for delicate taps</string>
